 "manifest": {
  "about": {
   "assumptions": [
    "The main patterns of the pixels (PCA), the pixels or the image features separate the classes linearly"
   ],
   "avoid_when": [
    "The images are large or very different (the model is linear)",
    "You need high accuracy on photographs"
   ],
   "data_needs": [
    "An image dataset from an image folder upload: pixels and a label for each image",
    "Images of the same size (the upload can resize them)",
    "Or, with input 'features', image features from the dl.embed step"
   ],
   "difficulty": "intermediate",
   "example": "Classify 16 x 16 pictures of circles, squares and crosses, and test on 25% of them.",
   "expert_notes": "Bayesian multinomial logistic regression (PyMC, NUTS) on PCA scores of the pixels (or the block-averaged pixels), with zero-sum normal priors over the classes. With input 'features' (v1.1) it reads feature(image, feature) from the dl.embed step: standardised features, PCA only above max_features. Draws representation of y_hat(chain, draw, image, class).",
   "fits": {
    "data_shape": [
     "images"
    ],
    "frequency": [
     "not_time"
    ],
    "goal": [
     "classify"
    ],
    "uncertainty": [
     "essential",
     "nice"
    ]
   },
   "outputs": [
    "The probability of each class for each image, with a range",
    "Images of the main patterns and of the class means in the run"
   ],
   "related": [
    "sklearn.multiclass_classifier",
    "core.stratified",
    "core.column",
    "dl.embed",
    "dl.cnn_classifier"
   ],
   "summary_plain": "Learns the class of small images, such as shapes or digits, from labelled examples. It gives the probability of each class with a range.",
   "title": "Classify small images",
   "typical_runtime": "minutes",
   "use_when": [
    "You have a few hundred to a few thousand small images with a class label",
    "You want a probability with a range for each class"
   ]
  },
  "capabilities": {
   "inference": "mcmc",
   "loo_invalid_reason": "the model stores no pointwise log-likelihood",
   "loo_valid": false,
   "representation": "draws",
   "score_modes": [
    "evaluate",
    "predict"
   ]
  },
  "description": "A Bayesian multinomial logistic regression for small images of the same size: principal component scores (or block means) of the pixels predict the class, with zero-sum normal priors on the class weights.",
  "id": "tabular.image_logistic",
  "outputs": {
   "y_hat": {
    "description": "Probability of each class per image (sums to 1 over class)",
    "dims": [
     "class"
    ],
    "dims_of": "label",
    "units": "1"
   }
  },
  "plots": [
   "core.roc_pr",
   "core.confusion",
   "core.convergence"
  ],
