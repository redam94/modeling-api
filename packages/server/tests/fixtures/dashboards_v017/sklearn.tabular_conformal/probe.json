 "size": "tiny",
 "source": "conformance fixture sklearn_store_demand",
 "spec": {
  "apiVersion": "mapi/v1",
  "data": {
   "bind": {
    "dims": {
     "sku": "sku",
     "store": "store_id",
     "time": "week"
    },
    "vars": {
     "price": "price",
     "promo": "promo_flag",
     "y": "units_sold"
    }
   },
   "dataset": "dataset://default/v017-sklearn-store-demand-14c181-data@v1",
   "split": {
    "dim": "time",
    "kind": "time_holdout",
    "last": 8
   }
  },
  "evaluate": {
   "metrics": [
    "rmse",
    "mape",
    "coverage_80"
   ]
  },
  "execution": {
   "resource_class": "S",
   "timeout": "10m"
  },
  "kind": "ModelSpec",
  "metadata": {
   "labels": {
    "corpus": "sklearn_store_demand"
   },
   "name": "v017-sklearn-store-demand-14c181-model",
   "project": "default"
  },
  "model": {
   "fit": {
    "mode": "evaluate_then_refit",
    "seed": 7
   },
   "settings": {
    "columns": {
     "roles": [
      "covariate"
     ]
    },
    "coord_features": {
     "sku": "category",
     "store": "category"
    },
    "estimator": {
     "kind": "sklearn.HistGradientBoostingRegressor",
     "params": {
      "learning_rate": 0.15,
      "max_iter": 60,
      "max_leaf_nodes": 31
     }
    },
    "forecast_strategy": "direct",
    "retransform": "median",
    "rows": [
     "store",
     "sku",
     "time"
    ],
    "uncertainty": {
     "alpha": 0.2,
     "calibration": 0.2,
     "kind": "conformal"
    }
   },
   "use": "sklearn.tabular_conformal@^1"
  },
  "outputs": {
   "plots": [
    "core.fit_vs_actual",
    "core.residuals_over_time"
   ]
  },
  "pipeline": [
   {
    "id": "imp",
    "use": "core.impute@^1",
    "with": {
     "along": "time",
     "method": "ffill",
     "unseen_levels": "pooled",
     "vars": [
      "price"
     ],
     "within": [
      "store",
      "sku"
     ]
    }
   },
   {
    "id": "plags",
    "use": "core.lag@^1",
    "with": {
     "along": "time",
     "lags": [
      1,
      2
     ],
     "vars": [
      "promo"
     ],
     "within": [
      "store",
      "sku"
     ]
    }
   },
   {
    "id": "cal",
    "use": "core.calendar@^1",
    "with": {
     "along": "time",
     "features": [
      "week_of_year",
      "month"
     ]
    }
   },
   {
    "id": "logy",
    "use": "core.log1p@^1",
    "with": {
     "vars": [
      "y"
     ]
    }
   }
  ]
 },
 "version_metrics": {
