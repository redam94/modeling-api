# modeling-api environment reference. Copy to `.env` (git-ignored) and edit.
#
#   docker compose   reads .env automatically (variable interpolation in docker-compose.yml).
#   make dev         does NOT read .env: it uses your shell environment. Export what you need
#                    (or use direnv). `make dev` needs none of these; the defaults just work.
#
# Every MAPI_* variable the stack reads is listed here: tests/devops checks this file against
# the code (mapi_server.settings.Settings, mapi_spec.localdev, the runner contract, compose,
# the images and scripts/dev.py). Lines starting with `#` are documentation or defaults.

# ============================================================================ compose only
# Password of the compose Postgres role `mapi`. Required by docker compose; local use only.
POSTGRES_PASSWORD=change-me-local-only

# Tag of the mapi/* images compose runs (`make docker-build` tags the workspace version).
# MAPI_VERSION=0.12.0

# Resources of the compose worker; every local-process run uses its /tmp as scratch space.
# MAPI_WORKER_TMPFS=4g
# MAPI_WORKER_MEMORY=12g
# MAPI_WORKER_CPUS=4

# Group id owning /var/run/docker.sock (only for the docker-executor override example).
# DOCKER_GID=0

# =================================================== local topology (mapi_spec.localdev)
# Bucket-name environment: buckets are mapi-{MAPI_ENV}-{quarantine,bootstrap,runs,...}.
# MAPI_ENV=local

# PostgreSQL. Unset under `make dev` = embedded pgserver in $MAPI_DATA_DIR/pg (no Docker).
# Compose builds it from POSTGRES_PASSWORD. Any postgresql:// URL works.
# DATABASE_URL=postgresql://mapi:change-me-local-only@127.0.0.1:5432/mapi

# Where the API listens / is reached (http://127.0.0.1:8000).
# MAPI_API_URL=http://127.0.0.1:8000

# Host header values the API answers (comma-separated; the host of MAPI_API_URL is always
# allowed; '*' turns the check off). The M1 API is unauthenticated, so this is what stops a
# DNS-rebinding web page from using it. Add a name here if you reach the stack by another one.
# MAPI_ALLOWED_HOSTS=127.0.0.1,localhost,api
# Proxies in front of the API (addresses or CIDR ranges, comma-separated) whose
# X-Forwarded-For gives the caller's address; 'none' when clients connect directly.
# Required in the multi-tenant profile.
# MAPI_TRUSTED_PROXIES=none

# The GCS shim (local Cloud Storage emulator); signed URLs point here (http://127.0.0.1:4443).
# MAPI_GCS_ENDPOINT=http://127.0.0.1:4443

# The web app origin (Vite dev server under `make dev`, nginx under compose).
# MAPI_WEB_ORIGIN=http://127.0.0.1:5173

# The plot sandbox origin. MUST differ from MAPI_WEB_ORIGIN (plots run in a sandboxed iframe).
# MAPI_PLOTS_ORIGIN=http://127.0.0.1:5174

# Local state: pgserver data (pg/), shim objects (gcs/), supervisor state (dev/).
# MAPI_DATA_DIR=.local

# ============================================================ control plane (mapi-server)
# mapi_server.settings.Settings reads every MAPI_<FIELD> below (api, worker, migrate, dev).
# Defaults are shown; numbers ending in _s are seconds.

# --- identity and deployment
# single-tenant | multi-tenant | dev (the local-process executor refuses multi-tenant).
# MAPI_PROFILE=single-tenant
# `make dev` and compose set MAPI_PROFILE from MAPI_STACK_PROFILE (default dev: the built-in
# development IdP at /dev/idp, the default tenant and project, and the seeded accounts below;
# admin@dev.local is the tenant admin and a platform operator). Scripts and the e2e suites
# sign in through it (mapi_client.oidc.dev_idp_login) as MAPI_DEV_ACCOUNT in MAPI_PROJECT.
# MAPI_STACK_PROFILE=dev
# MAPI_DEV_ACCOUNT=admin@dev.local
# The one tenant and project of an M1 install (created on start-up).
# MAPI_TENANT_ID=default
# MAPI_PROJECT_ID=default
# Include tracebacks in problem.untrusted_text (local debugging only).
# MAPI_DEBUG=false
# debug | info | warning | error
# MAPI_LOG_LEVEL=info
# Observability: JSON logs, Prometheus /metrics (with its scrape bearer; required by the
# multi-tenant profile), OpenTelemetry spans and an optional OTLP/HTTP collector.
# MAPI_LOG_JSON=true
# MAPI_METRICS_ENABLED=true
# MAPI_METRICS_TOKEN=
# MAPI_WORKER_METRICS_PORT=
# MAPI_WORKER_METRICS_HOST=127.0.0.1
# MAPI_TRACING_ENABLED=true
# MAPI_OTLP_ENDPOINT=
# Where `mapi-server api` / `dev` bind when --host/--port are not given.
# MAPI_API_HOST=127.0.0.1
# MAPI_API_PORT=8000

# --- database (DATABASE_URL above; MAPI_DATABASE_URL is an alias that wins over it)
# MAPI_DATABASE_URL=
# MAPI_DB_POOL_SIZE=10
# MAPI_DB_ECHO=false

# --- object store
# shim (the GCS shim at MAPI_GCS_ENDPOINT) | gcs (real Cloud Storage, `gcp` extra; URLs signed
# keylessly through IAM signBlob as MAPI_URL_SIGNER) | memory (in-process; tests only).
# MAPI_OBJECT_STORE=shim
# MAPI_GCP_PROJECT=
# MAPI_URL_SIGNER=
# MAPI_URL_UPLOADER=
# The shim's state directory; the API and worker read the principal key files under
# <root>/_shim/keys/ (control: the object store; exec: MAPI_EXEC_TOKEN for local runs).
# Default: $MAPI_DATA_DIR/gcs. MAPI_GCS_KEY_FILE overrides the control key file alone.
# MAPI_GCS_ROOT=.local/gcs
# MAPI_GCS_KEY_FILE=
# Base URL put into signed URLs when browsers or containers reach the shim under another
# host name than MAPI_GCS_ENDPOINT (default: MAPI_GCS_ENDPOINT).
# MAPI_GCS_PUBLIC_ENDPOINT=

# --- executors (`mapi-server worker`)
# local-process (default) | docker | docker-gvisor | cloudrun-jobs (gcp extra; see below).
# MAPI_EXECUTOR=local-process
# argv of the supervisor (shell-quoted); default: the mapi-runner next to the interpreter.
# MAPI_RUNNER_COMMAND=mapi-runner
# Docker executors (compose.override.example.yml sets the first three):
#   image for runs without a mapped plugin (ingest, describe); default
#   mapi/base-bayes:<workspace version>, the tag `make docker-build` gives it.
# MAPI_DOCKER_IMAGE=
#   plugin namespace -> image (JSON). Default: mmm and tabular -> mapi/base-bayes,
#   sklearn -> mapi/base-ml, ts -> mapi/base-forecast, all tagged with the workspace version.
# MAPI_DOCKER_IMAGES={"mmm": "mapi/base-bayes:<version>", "sklearn": "mapi/base-ml:<version>"}
#   network of the run containers: container:<gcs-shim container> (shares 127.0.0.1:4443)
#   or an internal network holding only the shim. The default `none` is refused while the
#   bootstrap URL is HTTP (nothing would be reachable), so set this for docker runs.
# MAPI_DOCKER_NETWORK=none
# MAPI_DOCKER_NETWORK_ISOLATED=false
# MAPI_DOCKER_RUNTIME_GVISOR=runsc
# Per-execution work dirs and pid files (default: $MAPI_DATA_DIR/executions).
# MAPI_EXECUTOR_WORKDIR=
# Grace between SIGTERM and SIGKILL when a run is cancelled or times out.
# MAPI_CANCEL_GRACE_S=10.0

# --- Cloud Run Jobs (MAPI_EXECUTOR=cloudrun-jobs; docs/operations/cloud-run.md)
# The exec project holding the Job inventory (required) and its region.
# MAPI_CLOUDRUN_PROJECT=
# MAPI_CLOUDRUN_REGION=europe-west1
# Data residency of the platform tenant and of tenants created without one (default: the
# multi-region of MAPI_CLOUDRUN_REGION with cloudrun-jobs, e.g. eu; else us).
# MAPI_DEFAULT_RESIDENCY=
# Job id convention ({env}, {base} = base-bayes|base-ml|base-forecast, {class} = s|m|l);
# it must match the Jobs the infrastructure creates.
# MAPI_CLOUDRUN_JOB_TEMPLATE=mapi-{env}-{base}-{class}
#   plugin namespace -> base (JSON); default mmm and tabular -> base-bayes,
#   sklearn -> base-ml, ts -> base-forecast.
# MAPI_CLOUDRUN_PLUGIN_BASES={"mmm": "base-bayes", "sklearn": "base-ml", "ts": "base-forecast"}
# MAPI_CLOUDRUN_DEFAULT_BASE=base-bayes
# jobs.run token bucket per orchestrator (the regional quota is 180/min [verify M0]).
# MAPI_CLOUDRUN_SUBMITS_PER_MINUTE=150.0
# MAPI_CLOUDRUN_SUBMIT_BURST=10
# 429 handling: answers in a row before a submit fails, exponential back-off base and cap.
# MAPI_CLOUDRUN_MAX_429_RETRIES=6
# MAPI_CLOUDRUN_BACKOFF_BASE_S=1.0
# MAPI_CLOUDRUN_BACKOFF_CAP_S=64.0
# Task timeout = run timeout + margin (the supervisor flushes checkpoints first).
# MAPI_CLOUDRUN_TIMEOUT_MARGIN_S=120
# Network controls the exec project enforces; public tenants need both [verify M0].
# MAPI_CLOUDRUN_EGRESS_ENFORCED=true
# MAPI_CLOUDRUN_DNS_ENFORCED=false
# How far back orphan adoption lists executions (seconds).
# MAPI_CLOUDRUN_ADOPT_LOOKBACK_S=93600

# --- dispatcher, reconciler, finalizer
# MAPI_DISPATCH_RATE_PER_MINUTE=180.0
# MAPI_DISPATCH_BURST=10
# MAPI_DISPATCH_BATCH=10
# MAPI_DISPATCH_POLL_S=1.0
# MAPI_DISPATCH_LEASE_S=120.0
# Trust tiers this orchestrator leases (comma-separated; empty: all). Give orchestrators of
# different exec pools disjoint lists, e.g. internal,self-hosted-trusted,verified and public.
# MAPI_DISPATCH_TIERS=
# MAPI_RECONCILE_INTERVAL_S=10.0
# A run is STALLED after MAPI_STALL_INTERVALS progress intervals of silence.
# MAPI_STALL_INTERVALS=15
# How long the complete event may lag an exited execution (log pipeline delay).
# MAPI_COMPLETE_EVENT_GRACE_S=60.0
# How long after submission an execution the executor cannot find is tolerated (then LOST).
# MAPI_LOST_EXECUTION_GRACE_S=60.0
# Automatic retries of infrastructure failures, and no auto-retry after this window.
# MAPI_MAX_INFRA_RETRIES=2
# MAPI_AUTO_RETRY_WINDOW_S=1800.0
# No auto-retry once a run has cost this multiple of its estimate.
# MAPI_AUTO_RETRY_COST_FACTOR=2.0
# Sweep of expired upload intents, browser sessions, sign-ins and rate counters.
# MAPI_HOUSEKEEPING_INTERVAL_S=300.0
# Days after a run ends that its metric points and structured log lines are kept (unset: kept
# with the run). Summaries, params, tags and notes are always kept.
# MAPI_TRACKING_RETENTION_DAYS=
# MAPI_FINALIZE_MAX_ATTEMPTS=5
# Extra time past an attempt's deadline (its timeout) before the reconciler ends it.
# MAPI_DEADLINE_GRACE_S=60.0
# Size cap of a JSON sidecar (metrics, ui/ views, plots) the control plane reads.
# MAPI_MAX_SIDECAR_BYTES=8388608

# --- API
# Bearer required by POST /internal/events (the events push endpoint) when set. In the
# cloud, use the Pub/Sub OIDC settings below instead.
# MAPI_INTERNAL_TOKEN=
# Pub/Sub push with OIDC: the expected token audience and push service account (set both),
# the accepted subscriptions (comma-separated; empty = any) and Google's JWKS.
# MAPI_PUBSUB_PUSH_AUDIENCE=
# MAPI_PUBSUB_PUSH_SERVICE_ACCOUNT=
# MAPI_PUBSUB_PUSH_SUBSCRIPTIONS=
# MAPI_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# SSE heartbeat interval, and the fallback poll when no Postgres NOTIFY arrives.
# MAPI_SSE_HEARTBEAT_S=15.0
# MAPI_SSE_POLL_S=5.0
# How often an open event stream re-checks its caller's credential.
# MAPI_SSE_REAUTH_S=60.0

# --- authentication and tenancy (v0.3; see docs/operations/authentication.md)
# Credentials on every non-public route: on in every profile except single-tenant.
# MAPI_AUTH_REQUIRED=
# Root secret of the API-token pepper, audit fingerprints and webhook sealing key; default:
# the file MAPI_SERVER_SECRET_PATH (server-secret next to the bundle-signing key, by migrate).
# MAPI_SERVER_SECRET=
# MAPI_SERVER_SECRET_PATH=
# __Host-/Secure cookies (default: on when MAPI_API_URL is https).
# MAPI_COOKIE_SECURE=
# OpenID provider of the browser sign-in (BFF); the dev profile uses its built-in IdP.
# MAPI_OIDC_ISSUER=https://accounts.google.com
# MAPI_OIDC_DISCOVERY_URL=
# MAPI_OIDC_CLIENT_ID=
# MAPI_OIDC_CLIENT_SECRET=
# MAPI_OIDC_REDIRECT_URI=
# MAPI_OIDC_ALGORITHMS=RS256,ES256
# Public OIDC clients (the mapi CLI) whose ID tokens are accepted as bearers; empty: none.
# MAPI_OIDC_CLI_CLIENT_IDS=mapi-cli
# MAPI_OIDC_EXTRA_PARAMS={}
# Verified e-mails of platform operators; e-mails invited as admins of the default tenant.
# MAPI_OPERATOR_EMAILS=
# MAPI_DEFAULT_TENANT_ADMINS=
# Accounts of the development IdP (MAPI_PROFILE=dev only).
# MAPI_DEVIDP_USERS=admin@dev.local,analyst@dev.local,viewer@dev.local
# Runtime database roles (created by migrate) and optional dedicated logins for them:
# app (tenant sessions), system (the orchestrator; the only RLS bypass), gateway (the API's
# lookups before a tenant is known; RLS applies).
# MAPI_DB_APP_ROLE=mapi_app
# MAPI_DB_SYSTEM_ROLE=mapi_system
# MAPI_DB_GATEWAY_ROLE=mapi_gateway
# MAPI_DATABASE_APP_URL=
# MAPI_DATABASE_SYSTEM_URL=
# MAPI_DATABASE_GATEWAY_URL=
# MAPI_DB_SYSTEM_POOL_SIZE=5
# MAPI_DB_GATEWAY_POOL_SIZE=5

# --- quotas and cost (v0.3)
# A JSON PriceTable (default: Cloud Run-like list prices).
# MAPI_PRICE_TABLE_PATH=
# Wall-time estimate per run kind charged against vCPU-second quotas until metered (JSON).
# MAPI_ESTIMATE_WALL_S=
# MAPI_RATE_LIMITS_ENABLED=true
# MAPI_LEASE_CANDIDATES=500
# MAPI_LEASE_CANDIDATES_PER_TENANT=50
# MAPI_EXECUTOR_REPORT_INTERVAL_S=10.0
# MAPI_EXECUTOR_EVIDENCE_MAX_AGE_S=259200.0

# --- webhooks (v0.4; see docs/guides/endpoints-and-webhooks.md)
# The worker's relay looks for due deliveries this often (procrastinate "webhooks" queue).
# MAPI_WEBHOOK_POLL_INTERVAL_S=2.0
# Tries per delivery; consecutive failed events before a webhook is disabled.
# MAPI_WEBHOOK_MAX_ATTEMPTS=8
# MAPI_WEBHOOK_AUTO_DISABLE_AFTER=20
# MAPI_WEBHOOK_MAX_PER_PROJECT=25
# MAPI_WEBHOOK_RETENTION_DAYS=30
# Extra PEM CA bundle trusted for webhook receivers (a private CA).
# MAPI_WEBHOOK_CA_FILE=
# Development only (refused in the multi-tenant profile): hosts exempt from the SSRF address
# and port checks, and http:// for those hosts.
# MAPI_WEBHOOK_DEV_ALLOWLIST=
# MAPI_WEBHOOK_ALLOW_HTTP=false

# --- workflows (v0.5; see docs/guides/workflows.md)
# How often (seconds) the orchestrator advances active workflow runs.
# MAPI_WORKFLOW_TICK_S=1.0
# Per project: workflow runs going at once, active cron schedules, active dataset triggers.
# MAPI_WORKFLOW_MAX_ACTIVE_RUNS=20
# MAPI_WORKFLOW_MAX_SCHEDULES=20
# MAPI_WORKFLOW_MAX_TRIGGERS=20
# Timeout (seconds) of a node without its own timeout; largest JSON output of a node (bytes).
# MAPI_WORKFLOW_NODE_TIMEOUT_S=1800
# MAPI_WORKFLOW_MAX_JSON_OUTPUT_BYTES=1048576

# --- plot rendering and embed links (v0.4)
# Wall-clock limit of a POST /v1/plots:render run.
# MAPI_RENDER_TIMEOUT_S=300
# Wall-clock limit of an upload inspect run (v0.8; it reads only the file's metadata).
# MAPI_INSPECT_TIMEOUT_S=300
# Accept Plotly renders (needs kaleido and a Chrome/Chromium in the runner image).
# MAPI_RENDER_PLOTLY_ENABLED=false
# Public embed views per minute: per link, and per client address (valid or not).
# MAPI_EMBED_RATE_PER_MINUTE=300
# MAPI_EMBED_IP_RATE_PER_MINUTE=120
# How long an API instance reuses an embed's resolved plot (also the response's max-age).
# MAPI_EMBED_CACHE_S=60.0
# Lifetime of the signed URL of an embed's PNG fallback.
# MAPI_EMBED_IMAGE_URL_TTL_S=900

# --- catalog and image digest
# Catalog JSON exported at image build (/opt/mapi/catalog.json in the runner images);
# unset = a describe run fills the catalog cache.
# MAPI_CATALOG_PATH=
# The image digest the catalog is cached under, which api and worker must agree on:
# MAPI_IMAGE_DIGEST (sha256:<64 hex>), else sha256 of MAPI_UV_LOCK_PATH, else (make dev) the
# sha256 of the uv.lock above the working directory and of the workspace sources
# (packages/*/src, plugins/*/src), so a code change makes a new catalog. The mapi/server and
# mapi/worker images bake their lock and set MAPI_UV_LOCK_PATH=/opt/mapi/uv.lock.
# MAPI_IMAGE_DIGEST=
# MAPI_UV_LOCK_PATH=

# --- bundle signing
# The bundle-signing key (P-256 PEM). The worker's finalizer signs bundle manifests with it
# and the API verifies them, so both must load the SAME file, on storage that survives
# restarts. `mapi-server migrate` creates it. Compose keeps it on the `keys` volume
# (/var/lib/mapi/keys/bundle-signing-p256.pem) and turns creation off for api and worker.
# Default: $MAPI_DATA_DIR/keys/bundle-signing-p256.pem, created on first use.
# MAPI_SIGNING_KEY_PATH=
# MAPI_SIGNING_KEY_CREATE=true
# Retired signing keys (PEM, public or private; comma-separated) that still verify the
# bundles they signed, after a key rotation (ops/runbooks/rotating-keys.md).
# MAPI_SIGNING_TRUSTED_KEY_PATHS=
# Or sign with Cloud KMS (gcp extra): the key version that signs, and older versions whose
# signatures still verify (comma-separated, for rotation).
# MAPI_SIGNER=local
# MAPI_KMS_KEY_VERSION=
# MAPI_KMS_TRUSTED_KEY_VERSIONS=

# --- sign-up and e-mail (v0.4; docs/operations/signup-and-abuse.md)
# Self-service sign-up (default: on in dev and multi-tenant when a mailer works).
# MAPI_SIGNUP_ENABLED=
# console | outbox | smtp | none (default: outbox in dev, smtp multi-tenant, else console).
# Multi-tenant refuses console and outbox while sign-up is on.
# MAPI_MAILER=
# MAPI_MAIL_FROM=modeling-api <no-reply@mapi.localhost>
# MAPI_OUTBOX_DIR=            (default: $MAPI_DATA_DIR/outbox; read at GET /dev/outbox in dev)
# MAPI_SMTP_HOST=
# MAPI_SMTP_PORT=587
# MAPI_SMTP_TLS=starttls      (or ssl, implicit TLS on 465)
# MAPI_SMTP_USERNAME=
# MAPI_SMTP_PASSWORD=
# MAPI_SMTP_TIMEOUT_S=10.0
# The e-mailed link ({token} is replaced; default: $MAPI_WEB_ORIGIN/verify-email?token={token}).
# MAPI_SIGNUP_VERIFY_URL=
# Disposable domains besides the built-in list (comma-separated), or a file (one per line).
# MAPI_SIGNUP_BLOCKED_DOMAINS=
# MAPI_SIGNUP_BLOCKLIST_PATH=
# Sign-up rate limits and the Sybil heuristics (flag for review after N workspaces per
# address, browser or e-mail within the window).
# MAPI_SIGNUP_PER_IP_PER_HOUR=5
# MAPI_SIGNUP_PER_DOMAIN_PER_DAY=25
# MAPI_SIGNUP_GLOBAL_PER_HOUR=500
# Free-mail domains with no per-domain cap and no domain-burst flag (replaces the list)
# MAPI_SIGNUP_SHARED_EMAIL_DOMAINS=gmail.com,outlook.com,yahoo.com
# MAPI_VERIFY_PER_IP_PER_MINUTE=20
# MAPI_SIGNUP_SYBIL_WINDOW_DAYS=30
# MAPI_SIGNUP_SYBIL_THRESHOLD=3
# MAPI_SIGNUP_FLAGGED_SUSPEND=false
# MAPI_SIGNUP_RETENTION_DAYS=30
# Cut line B (M5): identity-verified public tenants may run uploaded code. Off through M4.
# MAPI_PUBLIC_CODE_UPLOAD_ENABLED=false

# --- tenant deletion and GDPR export (v0.4; docs/guides/data-deletion.md)
# MAPI_TENANT_DELETION_GRACE_S=604800.0
# MAPI_DELETION_REAUTH_MAX_AGE_S=
# MAPI_DELETION_RUN_STOP_TIMEOUT_S=3600.0
# MAPI_DELETION_MAX_ATTEMPTS=8
# The bundles bucket's retention (Terraform bundle_retention_days): when locked objects retry.
# MAPI_BUNDLE_RETENTION_DAYS=30
# MAPI_LIFECYCLE_INTERVAL_S=15.0
# MAPI_EXPORT_MAX_INLINE_BYTES=268435456
# MAPI_EXPORT_RETENTION_S=604800.0
# MAPI_EXPORT_LINK_TTL_S=900.0
# MAPI_EXPORTS_PER_DAY=3
# MAPI_EXPORT_MAX_METADATA_BYTES=268435456
# MAPI_EXPORT_BUILD_TIMEOUT_S=3600.0

# ============================================================== make dev (scripts/dev.py)
# Replace one service's command (shell-quoted). NAME = GCS_SHIM, MIGRATE, API, WORKER, WEB, PLOTS.
# MAPI_DEV_API_CMD=uvicorn mapi_server.app:app --reload --host 127.0.0.1 --port 8000
# MAPI_DEV_GCS_SHIM_CMD=
# MAPI_DEV_MIGRATE_CMD=
# MAPI_DEV_WORKER_CMD=
# MAPI_DEV_WEB_CMD=
# MAPI_DEV_PLOTS_CMD=
# Output colours: NO_COLOR=1 disables, FORCE_COLOR=1 forces (e.g. when piping to a pager).

# ================================================================== mapi/web (nginx image)
# Where nginx proxies /v1/ (same-origin API for the SPA, SSE-safe).
# MAPI_API_UPSTREAM=http://api:8000
# Host names the app server answers (space-separated); any other Host gets no response
# (DNS-rebinding guard for the proxied API). Keep in step with MAPI_ALLOWED_HOSTS.
# MAPI_WEB_SERVER_NAMES=127.0.0.1 localhost
# Extra script-src sources for the app CSP. Empty by default; widening it needs review.
# MAPI_WEB_SCRIPT_SRC_EXTRA=

# ===================================================== runner images (set inside the image)
# Baked, read-only compile caches and their writable symlink farm (images/common).
# MAPI_CACHE_SEED=/opt/mapi/cache
# MAPI_CACHE_DIR=/tmp/mapi-cache

# ============================================ per-run, set by executors — never set by hand
# These identify one execution of the runner (docs/reference/run-protocol.md, Environment).
# MAPI_RUN_ID=
# MAPI_NONCE=
# MAPI_BOOTSTRAP_URL=http://127.0.0.1:4443/storage/v1/b/mapi-local-bootstrap/o/{nonce}
# MAPI_EXEC_TOKEN=          (local executor only; never in the cloud)
# MAPI_REQUIRE_ISOLATION=1  (docker executor: fail the run instead of running in dev mode)
