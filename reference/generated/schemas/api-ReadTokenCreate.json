{
  "$id": "https://schemas.mapi.dev/v1/api-ReadTokenCreate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``POST \u2026/read-tokens``: a read token for this dashboard, owned by the caller. The\nserver sets the scope (``dashboard:<dashboard_id>``) and the owner.",
  "examples": [
    {
      "expires_in_days": 30,
      "name": "Claude Desktop"
    }
  ],
  "properties": {
    "expires_in_days": {
      "default": 30,
      "maximum": 90,
      "minimum": 1,
      "title": "Expires In Days",
      "type": "integer"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "ReadTokenCreate",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
