{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "https://schemas.mapi.dev/v1/api-LibraryValidateRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Check a document; with ``dataset``, also its slots and variables against the data.",
  "examples": [
    {
      "dataset": "dataset://growth/store_sales@latest",
      "document": {
        "apiVersion": "mapi/v1",
        "base": "declarative",
        "declarative": {
          "groups": [
            {
              "dim": "store"
            }
          ],
          "outcome": {
            "family": "negative_binomial",
            "var": "sales"
          },
          "terms": [
            {
              "prior": {
                "sigma": 0.5
              },
              "sign": "negative",
              "transform": [
                {
                  "use": "log1p"
                }
              ],
              "var": "price"
            },
            {
              "prior": {
                "sigma": 1.0
              },
              "sign": "positive",
              "var": "promo",
              "varies_by": "store"
            }
          ]
        },
        "kind": "ModelRecipe",
        "metadata": {
          "name": "store-sales",
          "title": "Store sales with promo lift"
        },
        "plots": [
          "core.ppc"
        ]
      }
    }
  ],
  "properties": {
    "dataset": {
      "anyOf": [
        {
          "description": "Dataset reference dataset://project/name@version",
          "examples": [
            "dataset://growth/eu_media_daily@latest"
          ],
          "pattern": "^dataset://([a-z0-9](?:[a-z0-9_-]{0,126}[a-z0-9])?)/([a-z0-9](?:[a-z0-9_-]{0,126}[a-z0-9])?)(?:@(latest|v\\d{1,9}|\\d{1,9}|sha256:[0-9a-f]{64}))?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset"
    },
    "document": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 262144,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The document as YAML or JSON text (instead of document)",
      "title": "Text"
    }
  },
  "title": "LibraryValidateRequest",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
