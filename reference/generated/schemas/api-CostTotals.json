{
  "$id": "https://schemas.mapi.dev/v1/api-CostTotals.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Sums over ledger entries (one currency).",
  "examples": [
    {
      "amount_micros": 93600,
      "attempts": 3,
      "currency": "USD",
      "gib_seconds": 14400,
      "runs": 3,
      "vcpu_seconds": 3600
    }
  ],
  "properties": {
    "amount_micros": {
      "default": 0,
      "title": "Amount Micros",
      "type": "integer"
    },
    "attempts": {
      "default": 0,
      "description": "Distinct (run, attempt) pairs",
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "gib_seconds": {
      "default": 0,
      "title": "Gib Seconds",
      "type": "number"
    },
    "runs": {
      "default": 0,
      "description": "Distinct runs",
      "minimum": 0,
      "title": "Runs",
      "type": "integer"
    },
    "vcpu_seconds": {
      "default": 0,
      "title": "Vcpu Seconds",
      "type": "number"
    }
  },
  "title": "CostTotals",
  "type": "object",
  "x-mapi-contract-version": "0.1"
}
