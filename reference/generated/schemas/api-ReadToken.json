{
  "$id": "https://schemas.mapi.dev/v1/api-ReadToken.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A dashboard read token as listed (never its secret or hash).",
  "examples": [
    {
      "created_at": "2026-10-15T09:30:00Z",
      "dashboard_id": "dsh_01jaf3k1m2n3p4q5r6s7t8v9w0",
      "expires_at": "2026-11-14T09:30:00Z",
      "id": "tok_01jaf3r1s2t3v4w5x6y7z8a9b0",
      "last_used_at": "2026-10-16T08:00:00Z",
      "name": "Claude Desktop",
      "owner_id": "usr_01jaf3a9b8c7d6e5f4g3h2j1k0",
      "owner_label": "Dana Client",
      "prefix": "7k2m9q4x"
    }
  ],
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dashboard_id": {
      "examples": [
        "run_01jaf3q2x8m9v7k5h4g3f2e1d0"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,127}$",
      "title": "Dashboard Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "examples": [
        "run_01jaf3q2x8m9v7k5h4g3f2e1d0"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "last_used_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Used At"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "owner_id": {
      "examples": [
        "run_01jaf3q2x8m9v7k5h4g3f2e1d0"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,127}$",
      "title": "Owner Id",
      "type": "string"
    },
    "owner_label": {
      "maxLength": 200,
      "title": "Owner Label",
      "type": "string"
    },
    "prefix": {
      "examples": [
        "7k2m9q4x"
      ],
      "pattern": "^[0-9a-hjkmnp-tv-z]{8}$",
      "title": "Prefix",
      "type": "string"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At"
    }
  },
  "required": [
    "id",
    "name",
    "prefix",
    "dashboard_id",
    "owner_id",
    "owner_label",
    "created_at",
    "expires_at"
  ],
  "title": "ReadToken",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
