{
  "$defs": {
    "Capabilities": {
      "additionalProperties": false,
      "description": "What a model plugin can do (declared in its manifest).",
      "properties": {
        "calibration": {
          "default": [],
          "description": "Calibration data the model uses from a spec's calibration block (M3)",
          "items": {
            "enum": [
              "business_priors",
              "lift_tests"
            ],
            "type": "string"
          },
          "title": "Calibration",
          "type": "array",
          "uniqueItems": true
        },
        "checkpointable": {
          "default": false,
          "title": "Checkpointable",
          "type": "boolean"
        },
        "contribution_scale": {
          "default": "none",
          "enum": [
            "additive",
            "multiplicative",
            "none"
          ],
          "title": "Contribution Scale",
          "type": "string"
        },
        "decision": {
          "default": false,
          "title": "Decision",
          "type": "boolean"
        },
        "deterministic_given_seed": {
          "default": true,
          "title": "Deterministic Given Seed",
          "type": "boolean"
        },
        "evidence": {
          "default": false,
          "title": "Evidence",
          "type": "boolean"
        },
        "fast_score": {
          "default": false,
          "title": "Fast Score",
          "type": "boolean"
        },
        "identified_quantities": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
            "type": "string"
          },
          "title": "Identified Quantities",
          "type": "array"
        },
        "inference": {
          "enum": [
            "mcmc",
            "vi",
            "map",
            "smc",
            "kalman",
            "point",
            "bootstrap",
            "custom"
          ],
          "title": "Inference",
          "type": "string"
        },
        "loo_invalid_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loo Invalid Reason"
        },
        "loo_valid": {
          "default": true,
          "title": "Loo Valid",
          "type": "boolean"
        },
        "owns": {
          "default": [],
          "items": {
            "enum": [
              "scaling",
              "carryover",
              "inverse_units",
              "recursion"
            ],
            "type": "string"
          },
          "title": "Owns",
          "type": "array",
          "uniqueItems": true
        },
        "recommend": {
          "default": false,
          "title": "Recommend",
          "type": "boolean"
        },
        "representation": {
          "$ref": "#/$defs/Representation"
        },
        "score_modes": {
          "items": {
            "enum": [
              "predict",
              "forecast",
              "counterfactual",
              "simulate",
              "filter",
              "evaluate"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Score Modes",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "inference",
        "representation",
        "score_modes"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "DataSchemaTemplate": {
      "additionalProperties": false,
      "description": "A DataSchema-shaped JSON template plus the settings parameters it depends on.\n\nResolution is pure and static: ``resolve(settings)`` extracts each declared parameter\nfrom the settings (falling back to its default), checks its type/enum, renders the\n:mod:`~mapi_spec.template` placeholders, deep-merges every matching ``case`` and\nvalidates the result as a :class:`DataSchema`.",
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/TemplateCase"
          },
          "maxItems": 64,
          "title": "Cases",
          "type": "array"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/TemplateParam"
          },
          "maxProperties": 64,
          "title": "Params",
          "type": "object"
        },
        "template": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Template",
          "type": "object"
        }
      },
      "required": [
        "template"
      ],
      "title": "DataSchemaTemplate",
      "type": "object"
    },
    "DerivedDecl": {
      "additionalProperties": false,
      "description": "A derived quantity (contributions, response curves, ...).",
      "properties": {
        "cache": {
          "default": "on_demand",
          "enum": [
            "fit",
            "on_demand"
          ],
          "title": "Cache",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dims": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "units": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "name",
        "dims"
      ],
      "title": "DerivedDecl",
      "type": "object"
    },
    "JsonValue": {},
    "OutputDecl": {
      "additionalProperties": false,
      "description": "An output variable the model writes (e.g. ``y_hat``).",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dims": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "dims_of": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The output also carries every dim of this input variable (e.g. 'y' for models whose data dims come from settings, such as the sklearn row dims)",
          "title": "Dims Of"
        },
        "units": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "units_of": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Take units from this input variable",
          "title": "Units Of"
        }
      },
      "required": [
        "dims"
      ],
      "title": "OutputDecl",
      "type": "object"
    },
    "Representation": {
      "description": "How a model encodes uncertainty in its outputs.",
      "enum": [
        "draws",
        "quantiles",
        "interval",
        "point",
        "moments"
      ],
      "title": "Representation",
      "type": "string"
    },
    "ResourceClass": {
      "description": "Executor resource class. Ordered: ``S < M < L < XL``.",
      "enum": [
        "S",
        "M",
        "L",
        "XL"
      ],
      "title": "ResourceClass",
      "type": "string"
    },
    "ResourceHint": {
      "additionalProperties": false,
      "description": "Resource guidance for scheduling.",
      "properties": {
        "default_class": {
          "$ref": "#/$defs/ResourceClass",
          "default": "S"
        },
        "est_fit_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Est Fit Seconds"
        },
        "gpu": {
          "default": false,
          "title": "Gpu",
          "type": "boolean"
        },
        "min_class": {
          "$ref": "#/$defs/ResourceClass",
          "default": "S"
        }
      },
      "title": "ResourceHint",
      "type": "object"
    },
    "TemplateCase": {
      "additionalProperties": false,
      "description": "Conditional fragment merged into the template when all ``when`` params match.",
      "properties": {
        "merge": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Merge",
          "type": "object"
        },
        "when": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "minProperties": 1,
          "title": "When",
          "type": "object"
        }
      },
      "required": [
        "when",
        "merge"
      ],
      "title": "TemplateCase",
      "type": "object"
    },
    "TemplateParam": {
      "additionalProperties": false,
      "description": "A settings value that a :class:`DataSchemaTemplate` depends on.",
      "properties": {
        "default": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "maxItems": 256,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dotted path into the settings (defaults to the parameter name)",
          "title": "Path"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "string_list",
            "integer_list"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "TemplateParam",
      "type": "object"
    }
  },
  "$id": "https://schemas.mapi.dev/v1/modelmanifest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Everything the control plane knows about a model plugin version (static JSON).",
  "properties": {
    "artifact_format": {
      "default": "zarr.zip/v1",
      "maxLength": 64,
      "title": "Artifact Format",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "derived": {
      "items": {
        "$ref": "#/$defs/DerivedDecl"
      },
      "title": "Derived",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "fit_schema": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Fit Schema",
      "type": "object"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "outputs": {
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$": {
          "$ref": "#/$defs/OutputDecl"
        }
      },
      "title": "Outputs",
      "type": "object"
    },
    "plots": {
      "items": {
        "type": "string"
      },
      "title": "Plots",
      "type": "array"
    },
    "resources": {
      "$ref": "#/$defs/ResourceHint"
    },
    "schema_template": {
      "$ref": "#/$defs/DataSchemaTemplate"
    },
    "settings_schema": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Settings Schema",
      "type": "object"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "capabilities",
    "schema_template"
  ],
  "title": "ModelManifest",
  "type": "object",
  "x-mapi-contract-version": "0.1"
}
