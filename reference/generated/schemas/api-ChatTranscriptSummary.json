{
  "$id": "https://schemas.mapi.dev/v1/api-ChatTranscriptSummary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One kept conversation (editors). ``principal_label`` is a user's display name or\n``Share link <name>``; it is never an IP address.",
  "examples": [
    {
      "conversation_id": "cnv_01jaf3t1v2w3x4y5z6a7b8c9d0",
      "expires_at": "2026-11-14T09:34:00Z",
      "first_at": "2026-10-15T09:30:00Z",
      "last_at": "2026-10-15T09:34:00Z",
      "principal_kind": "client",
      "principal_label": "Dana Client",
      "turns": 4
    }
  ],
  "properties": {
    "conversation_id": {
      "pattern": "^cnv_[0-9a-z]{26}$",
      "title": "Conversation Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "first_at": {
      "format": "date-time",
      "title": "First At",
      "type": "string"
    },
    "last_at": {
      "format": "date-time",
      "title": "Last At",
      "type": "string"
    },
    "principal_kind": {
      "enum": [
        "member",
        "client",
        "share"
      ],
      "title": "Principal Kind",
      "type": "string"
    },
    "principal_label": {
      "maxLength": 200,
      "title": "Principal Label",
      "type": "string"
    },
    "turns": {
      "minimum": 0,
      "title": "Turns",
      "type": "integer"
    }
  },
  "required": [
    "conversation_id",
    "principal_kind",
    "principal_label",
    "turns",
    "first_at",
    "last_at",
    "expires_at"
  ],
  "title": "ChatTranscriptSummary",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
