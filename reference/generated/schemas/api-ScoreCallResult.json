          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The dim that is time, when there is one",
          "title": "Time Dim"
        },
        "variable": {
          "maxLength": 256,
          "title": "Variable",
          "type": "string"
        }
      },
