    "ScoreSummary": {
      "description": "The requested summary of a score run as plain tables (``summary.json``), inlined in\n:class:`ScoreCallResult` so spreadsheets, BI tools and curl callers get numbers without\nzarr or Arrow. ``truncated``: more than :data:`SCORE_SUMMARY_MAX_CELLS` cells (use the\n``score.zarr.zip`` output for everything). ``conditioning`` (forecasts): what the\nforecast was conditioned on - the end of the fitted history and the actuals the request\nsupplied (:mod:`mapi_spec.actuals`); ``actuals`` holds those values next to the\npredictions they compare with.",
      "examples": [
        {
          "tables": [
            {
              "columns": [
                "geo",
                "time",
                "mean",
                "hdi_90_lower",
                "hdi_90_upper"
              ],
              "rows": [
                [
                  "de",
                  "2026-01-05",
                  1520.4,
                  1402.1,
                  1633.9
                ]
              ],
              "variable": "revenue"
            }
          ],
          "truncated": false
        },
        {
          "conditioning": {
            "actuals_through": "1961-03-01",
            "conditioned": true,
            "dim": "t",
            "fit_end": "1960-12-01",
            "horizon_source": "horizon",
            "message": "Forecast updated with 3 actuals (1961-01-01 to 1961-03-01) after the fitted history, which ends 1960-12-01; the model's parameters were not re-estimated. 8 periods forecast from 1961-04-01 to 1961-11-01.",
            "n_actuals": 3,
            "n_series": 1,
            "parameters": "fitted",
            "periods": 8,
            "revised": 0,
            "series": [
              {
                "actuals_through": "1961-03-01",
                "first_actual": "1961-01-01",
                "forecast_from": "1961-04-01",
                "forecast_to": "1961-11-01",
                "missing": 0,
                "n_actuals": 3,
                "n_forecast": 8,
                "origin": "1961-03-01",
                "revised": 0,
                "series": {}
              }
            ],
            "series_conditioned": 1,
            "truncated": false
          },
          "tables": [
            {
              "columns": [
                "t",
                "median",
                "q5",
                "q95"
              ],
              "rows": [
                [
                  "1961-01-01",
                  447.2,
                  424.9,
                  469.5
                ],
                [
                  "1961-04-01",
                  461.8,
                  431.0,
                  492.6
                ]
              ],
              "variable": "y_hat"
            }
          ],
          "truncated": false
        }
      ],
      "properties": {
        "actuals": {
          "description": "Forecasts with actuals: the actuals the request supplied, as tables named after the prediction variable they compare with (its coordinate columns, then `actual`), in the output's names and original units. Predictions on those periods are one-step-ahead: what the model expected before seeing each actual",
          "items": {
            "$ref": "#/$defs/ScoreSummaryTable"
