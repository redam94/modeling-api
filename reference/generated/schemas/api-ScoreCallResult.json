        },
        "tables": {
          "items": {
            "$ref": "#/$defs/ScoreSummaryTable"
          },
          "maxItems": 1000,
          "title": "Tables",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "title": "ScoreSummary",
      "type": "object"
    },
    "ScoreSummaryTable": {
      "description": "One output variable's summary as a table: the coordinate columns (one per dim), then\none column per statistic (``mean``, ``hdi_90_lower``, ...). Dates are ISO text.\n``period``: the variable is a circular output (``OutputDecl.circular``), summarised on the\ncircle (see the field). ``dims`` and ``time_dim`` say which columns are coordinates and\nwhich one is time; a server that predates them leaves both out. ``plots``: the recipe ids\nof the run's rendered plots (``plots.json``) that draw this variable, so a client can show\nthem next to the table.",
      "examples": [
        {
          "columns": [
            "geo",
            "time",
            "mean",
            "hdi_90_lower",
            "hdi_90_upper"
          ],
          "dims": [
            "geo",
            "time"
          ],
          "rows": [
            [
              "de",
              "2026-01-05",
              1520.4,
              1402.1,
              1633.9
            ]
          ],
          "time_dim": "time",
          "variable": "revenue"
        }
      ],
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Columns",
          "type": "array"
        },
        "dims": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The coordinate columns (the leading columns); the rest are statistics",
          "title": "Dims"
        },
        "period": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set for a circular output (an angle that wraps at one turn, in the output's units): the statistics are on the circle. `mean` is the circular mean, the intervals are centred on it, and every value is in [0, period). An interval with lower > upper crosses the seam (from 350 to 10 degrees)",
          "title": "Period"
        },
        "plots": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Za-z0-9_.\\-]{1,128}$",
                "type": "string"
