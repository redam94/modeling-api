  "$id": "https://schemas.mapi.dev/v1/api-DashboardRefitRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A request, made with an actuals upload, that the analyst refits the model with those\nnumbers (\u00a710.4). At most one ``open`` request per dashboard (a newer one supersedes it).\nApproval publishes the readout, ingests the numbers as a new version of the dashboard's\ndataset and starts ``refit_workflow_id`` as the approver; nothing runs before that.",
  "examples": [
    {
      "created_at": "2026-10-15T09:30:00Z",
      "dashboard_id": "dsh_01jaf3r1s2t3v4w5x6y7z8a9b0",
      "id": "drr_01jaf3v1w2x3y4z5a6b7c8d9e0",
      "readout_seq": 14,
      "requested_by": "usr_01jaf3c1l2i3e4n5t6a7b8c9d0",
      "requested_by_kind": "client",
      "status": "open"
    },
    {
      "created_at": "2026-10-15T09:30:00Z",
      "dashboard_id": "dsh_01jaf3r1s2t3v4w5x6y7z8a9b0",
      "dataset_version_id": "dsv_01jaf3y1z2a3b4c5d6e7f8g9h0",
      "decided_at": "2026-10-15T09:30:00Z",
      "decided_by": "usr_01jaf3a9b8c7d6e5f4g3h2j1k0",
      "id": "drr_01jaf3v1w2x3y4z5a6b7c8d9e0",
      "readout_seq": 14,
      "requested_by": "dss_01jaf3t1v2w3x4y5z6a7b8c9d0",
      "requested_by_kind": "share",
      "status": "approved",
      "workflow_run_id": "wfr_01jaf3x1y2z3a4b5c6d7e8f9g0"
    }
  ],
