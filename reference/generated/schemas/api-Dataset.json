{
  "$defs": {
    "DatasetAbout": {
      "description": "The About of a dataset: the owner's description plus a generated summary.\n\n``summary_generated`` and ``highlights`` come from the version's schema and coordinate\nsummary (:func:`describe_dataset`); ``warnings_plain`` from its ingest issues and profile.",
      "examples": [
        {
          "description_user": "Weekly media spend and revenue from the finance warehouse.",
          "highlights": [
            "104 weeks of history",
            "10 markets",
            "3 channels"
          ],
          "summary_generated": "Weekly data from 2023-01-01 to 2024-12-29 (104 weeks) for 10 markets and 3 channels, with 3 measures: revenue (the result you want to explain), spend (marketing spend) and price.",
          "warnings_plain": []
        }
      ],
      "properties": {
        "description_user": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description User"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "highlights": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Highlights",
          "type": "array"
        },
        "summary_generated": {
          "maxLength": 1000,
          "title": "Summary Generated",
          "type": "string"
        },
        "warnings_plain": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Warnings Plain",
          "type": "array"
        }
      },
      "required": [
        "summary_generated"
      ],
      "title": "DatasetAbout",
      "type": "object"
    }
  },
  "$id": "https://schemas.mapi.dev/v1/api-Dataset.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
    {
      "created_at": "2026-10-15T09:30:00Z",
      "id": "ds_01jaf3a1b2c3d4e5f6g7h8j9k0",
      "latest_version": 3,
      "name": "eu_media_daily",
      "project_id": "default",
      "ref": "dataset://default/eu_media_daily",
      "tenant_id": "default",
      "updated_at": "2026-10-15T09:30:00Z"
    }
  ],
  "properties": {
    "about": {
      "anyOf": [
        {
          "$ref": "#/$defs/DatasetAbout"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "M3.5: the description plus a summary generated from the schema"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "id": {
      "examples": [
        "run_01jaf3q2x8m9v7k5h4g3f2e1d0"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "latest_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Version"
    },
    "name": {
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,126}[a-z0-9])?$",
      "title": "Name",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
      "title": "Project Id",
      "type": "string"
    },
    "ref": {
      "description": "dataset://project/name (append @vN to pin)",
      "title": "Ref",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "project_id",
    "name",
    "ref",
    "created_at",
    "updated_at"
  ],
  "title": "Dataset",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
