    "MffOptions": {
      "additionalProperties": false,
      "description": "The MFF (\"model feature format\") long-table preset.\n\nOne row per ``(period, geography, product, campaign, outlet, creative, variable)`` with\nthe value in ``value_column``. ``Period`` becomes the time dim; ``VariableName`` values\nbecome data variables. The rest follows mmm-framework's MFF semantics (its\n``MFFLoader``), so both read a file the same way:\n\n* ``Geography`` and ``Product`` become dims when they hold more than one level. A blank\n  label (or ``National``, ``Total``, ``All``) is the coarser level: a variable given\n  only there (national TV) is spread across the levels - equal weights, or the KPI's\n  share of each level (``allocation``; mmm-framework's defaults: geographies equally,\n  products by sales). A variable may not mix the two levels.\n* ``Campaign``, ``Outlet`` and ``Creative`` are breakdowns: rows that differ only there\n  are summed, unless the column is listed in ``split`` (then it becomes a dim).\n\n``combine`` joins several key columns into one dim (``{\"geo\": [\"Geography\", \"Product\"]}``\ngives labels such as ``US|Watches``) - a model with one panel dim can then fit a\ngeography x product panel. A combined dim is created even when it has a single label,\nso ``{\"geo\": [\"Geography\"]}`` keeps a national table's geo dim.",
      "properties": {
        "allocation": {
          "additionalProperties": {
            "enum": [
              "equal",
              "kpi"
            ],
            "type": "string"
          },
          "description": "v0.5: how a variable given only at the coarser level (a blank or 'National' label) is spread across the levels of a key column: equally, or by the KPI's share of each level (the variable with role 'target', or 'kpi')",
          "title": "Allocation",
          "type": "object"
        },
        "combine": {
          "description": "M3: dim -> key columns whose labels are joined ('|') into that one dim",
          "maxProperties": 4,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Combine",
          "type": "object"
        },
        "freq": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pandas offset alias; inferred when omitted",
          "title": "Freq"
        },
        "key_columns": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key column -> dim name",
          "title": "Key Columns",
          "type": "object"
        },
        "kpi": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.5: the KPI variable of 'kpi' allocation",
          "title": "Kpi"
        },
        "missing": {
          "default": "allow",
          "enum": [
            "forbid",
            "allow",
            "mask"
          ],
          "title": "Missing",
          "type": "string"
        },
        "period_column": {
          "default": "Period",
          "title": "Period Column",
          "type": "string"
        },
        "roles": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Variable -> role",
          "title": "Roles",
          "type": "object"
        },
        "split": {
          "description": "v0.5: breakdown key columns (Campaign, Outlet, Creative) kept as dims instead of summed",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Split",
          "type": "array"
        },
        "time_dim": {
          "default": "date",
          "title": "Time Dim",
          "type": "string"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Variable -> units",
          "title": "Units",
          "type": "object"
        },
        "value_column": {
          "default": "VariableValue",
          "title": "Value Column",
          "type": "string"
        },
        "variable_column": {
          "default": "VariableName",
          "title": "Variable Column",
          "type": "string"
        }
      },
      "title": "MffOptions",
      "type": "object"
    },
    "Role": {
      "description": "What a variable means to a model.",
      "enum": [
        "target",
        "covariate",
        "media",
        "spend",
        "control",
        "index",
        "mask",
        "constant",
        "weight",
        "exposure"
      ],
      "title": "Role",
      "type": "string"
    },
    "Severity": {
      "description": "How bad an :class:`Issue` is. Only ``error`` blocks submission.",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "Severity",
      "type": "string"
    },
    "VarMapping": {
      "additionalProperties": false,
      "description": "A data variable read from one column (dtype is inferred during ingest).",
      "examples": [
        {
          "column": "revenue",
          "role": "target",
          "units": "EUR"
        }
      ],
      "properties": {
        "column": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "missing": {
          "default": "forbid",
          "enum": [
            "forbid",
            "allow",
            "mask"
          ],
          "title": "Missing",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "covariate"
        },
        "units": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "column"
      ],
      "title": "VarMapping",
      "type": "object"
    },
    "WideVarMapping": {
      "additionalProperties": false,
      "description": "One variable read from several columns, one per label of ``dim`` (a wide table).\n\n``{\"dim\": \"channel\", \"columns\": {\"tv\": \"tv_spend\", \"search\": \"search_spend\"}}`` gives a\nvariable along ``channel`` (plus the table's other dims) with coords ``tv`` and\n``search``. Several wide variables may share a dim; their labels must then agree.",
      "examples": [
        {
          "columns": {
            "search": "search_spend",
            "social": "social_spend",
            "tv": "tv_spend"
          },
          "dim": "channel",
          "role": "spend",
          "units": "EUR"
        }
      ],
      "properties": {
        "columns": {
          "additionalProperties": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxProperties": 256,
          "minProperties": 1,
          "title": "Columns",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dim": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
          "title": "Dim",
          "type": "string"
        },
        "dim_spec": {
