    },
    "IngestMapping": {
      "additionalProperties": false,
      "description": "How an upload becomes a labelled dataset (Meridian ``CoordToColumns`` style).\n\nTabular formats need a mapping; ``zarr_zip``/``netcdf`` are self-describing and may omit\n``dims``/``vars``. Parsing happens only inside a sandboxed ingest run.\n\nWith the ``mff`` preset the long table is first pivoted to one column\nper ``VariableName`` (plus ``Period`` and the key columns); ``vars`` and ``wide`` then\npick and rename those variables (``column`` = a ``VariableName`` value) and ``dims`` may\nrefine the dims the preset derives (``column`` = an MFF column). Without ``vars`` and\n``wide`` every variable is kept under its own name.",
      "examples": [
        {
          "dims": {
            "date": {
              "column": "date",
              "spec": {
                "freq": "D",
                "kind": "time",
                "policy": "extend"
              }
            },
            "market": {
              "column": "market",
              "spec": {
                "kind": "categorical"
              }
            }
          },
          "format": "csv",
          "vars": {
            "revenue_local": {
              "column": "revenue",
              "role": "target",
              "units": "local"
            },
            "spend_local": {
              "column": "spend",
              "role": "spend",
              "units": "local"
            }
          }
        },
        {
          "dims": {
            "market": {
              "column": "market",
              "spec": {
                "kind": "categorical"
              }
            },
            "week": {
              "column": "week",
              "spec": {
                "freq": "W-SUN",
                "kind": "time",
                "policy": "extend"
              }
            }
          },
          "format": "csv",
          "vars": {
            "revenue": {
              "column": "revenue",
              "role": "target",
              "units": "EUR"
            }
          },
          "wide": {
            "spend": {
              "columns": {
                "search": "search_spend",
                "social": "social_spend",
                "tv": "tv_spend"
              },
              "dim": "channel",
              "role": "spend",
              "units": "EUR"
            }
          }
        },
        {
          "format": "mff",
          "mff": {
            "freq": "W-MON"
          },
          "preset": "mff"
        },
        {
          "format": "parquet",
          "meridian": {
            "kpi": "revenue",
            "media": [
              "tv_impressions"
            ],
            "media_channels": [
              "tv"
            ],
            "media_spend": [
              "tv_spend"
            ]
          },
          "preset": "meridian"
        }
      ],
      "properties": {
        "dims": {
          "additionalProperties": {
            "$ref": "#/$defs/DimMapping"
          },
          "maxProperties": 32,
          "title": "Dims",
          "type": "object"
        },
        "format": {
          "enum": [
            "csv",
            "parquet",
            "mff",
            "zarr_zip",
            "netcdf"
          ],
          "title": "Format",
          "type": "string"
        },
        "layout": {
          "default": "dense",
          "enum": [
            "dense",
            "long"
          ],
          "title": "Layout",
          "type": "string"
        },
        "meridian": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeridianColumns"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The meridian preset's columns"
        },
        "mff": {
          "anyOf": [
            {
              "$ref": "#/$defs/MffOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Options of the mff preset"
        },
        "preset": {
          "$ref": "#/$defs/IngestPreset",
          "default": "none",
          "description": "M3: a file contract instead of (or refined by) the column mapping"
        },
        "vars": {
          "additionalProperties": {
            "$ref": "#/$defs/VarMapping"
          },
          "maxProperties": 1024,
          "title": "Vars",
          "type": "object"
        },
        "wide": {
          "additionalProperties": {
            "$ref": "#/$defs/WideVarMapping"
          },
          "description": "M3: variables read from one column per label of a dim (wide tables)",
          "maxProperties": 64,
          "title": "Wide",
          "type": "object"
        }
      },
      "required": [
        "format"
      ],
      "title": "IngestMapping",
      "type": "object"
    },
    "IngestPreset": {
      "enum": [
        "none",
        "mff",
        "meridian"
      ],
      "title": "IngestPreset",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "One problem found while validating a document, located by a JSON pointer.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "context": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Context",
          "type": "object"
        },
        "message": {
          "description": "Trusted, platform-authored text",
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        },
        "pointer": {
          "default": "",
          "description": "RFC 6901 JSON pointer into the submitted document",
          "title": "Pointer",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "error"
        },
        "suggested_action": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Action"
        },
        "untrusted_text": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "User/plugin-originated text; render as text only",
          "title": "Untrusted Text"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "JsonValue": {},
    "MeridianColumns": {
      "additionalProperties": false,
      "description": "Google Meridian's ``CoordToColumns`` contract for a wide CSV/Parquet table.\n\n``media``/``media_spend`` (and ``reach``/``frequency``/``rf_spend``) are parallel lists:\nthe *i*-th column of each belongs to the *i*-th entry of ``media_channels``\n(``rf_channels``). ``geo`` is omitted for a national model; ``kpi_type`` says whether\nthe KPI is revenue (ROI in currency) or a count (``revenue_per_kpi`` converts it).",
      "examples": [
        {
          "controls": [
            "competitor_sales",
            "sentiment"
          ],
          "geo": "geo",
          "kpi": "conversions",
          "kpi_type": "non_revenue",
          "media": [
            "tv_impressions",
            "search_impressions"
          ],
          "media_channels": [
            "tv",
            "search"
          ],
          "media_spend": [
            "tv_spend",
            "search_spend"
          ],
          "population": "population",
          "revenue_per_kpi": "revenue_per_conversion",
          "time": "time"
        }
      ],
      "properties": {
        "controls": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Controls",
          "type": "array"
        },
        "freq": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "W",
          "description": "Time frequency (pandas alias)",
          "title": "Freq"
        },
        "frequency": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Frequency",
          "type": "array"
        },
        "geo": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "geo",
          "title": "Geo"
        },
        "kpi": {
          "default": "kpi",
          "maxLength": 256,
          "minLength": 1,
          "title": "Kpi",
          "type": "string"
        },
        "kpi_type": {
          "default": "revenue",
          "enum": [
            "revenue",
            "non_revenue"
          ],
          "title": "Kpi Type",
          "type": "string"
        },
        "media": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Media",
          "type": "array"
        },
        "media_channels": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Media Channels",
          "type": "array"
        },
        "media_spend": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Media Spend",
          "type": "array"
        },
        "non_media_treatments": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Non Media Treatments",
          "type": "array"
        },
        "organic_media": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Organic Media",
          "type": "array"
        },
        "population": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "reach": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Reach",
