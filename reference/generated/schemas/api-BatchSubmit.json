{
  "$defs": {
    "JsonValue": {},
    "XrJsonDataset": {
      "additionalProperties": false,
      "description": "An inline dataset (``xr.Dataset.to_dict()`` shape). Dim lengths must agree across\nvariables; every dim of a data variable should have a coord (checked in the sandbox\nagainst the model's schema).",
      "examples": [
        {
          "coords": {
            "channel": {
              "data": [
                "tv",
                "search"
              ],
              "dims": [
                "channel"
              ]
            },
            "time": {
              "data": [
                "2026-11-01",
                "2026-11-08"
              ],
              "dims": [
                "time"
              ]
            }
          },
          "data_vars": {
            "spend": {
              "data": [
                [
                  1000.0,
                  1200.0
                ],
                [
                  400.0,
                  380.0
                ]
              ],
              "dims": [
                "channel",
                "time"
              ]
            }
          }
        }
      ],
      "properties": {
        "attrs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 64,
          "title": "Attrs",
          "type": "object"
        },
        "coords": {
          "maxProperties": 64,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$": {
              "$ref": "#/$defs/XrJsonVariable"
            }
          },
          "title": "Coords",
          "type": "object"
        },
        "data_vars": {
          "maxProperties": 256,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$": {
              "$ref": "#/$defs/XrJsonVariable"
            }
          },
          "title": "Data Vars",
          "type": "object"
        },
        "dims": {
          "maxProperties": 16,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$": {
              "type": "integer"
            }
          },
          "title": "Dims",
          "type": "object"
        }
      },
      "required": [
        "data_vars"
      ],
      "title": "XrJsonDataset",
      "type": "object"
    },
    "XrJsonVariable": {
      "additionalProperties": false,
      "description": "A coord or data variable: ``data`` nested ``len(dims)`` deep (a scalar for no dims).",
      "properties": {
        "attrs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 64,
          "title": "Attrs",
          "type": "object"
        },
        "data": {
          "$ref": "#/$defs/JsonValue"
        },
        "dims": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Dims",
          "type": "array"
        }
      },
      "required": [
        "data"
      ],
      "title": "XrJsonVariable",
      "type": "object"
    }
  },
  "$id": "https://schemas.mapi.dev/v1/api-BatchSubmit.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``POST \u2026/batch``: the file as inline XrJSON (parsed in the browser from CSV), one row\nper case along the id column.",
  "examples": [
    {
      "inputs": {
        "coords": {
          "case_id": {
            "data": [
              "c1",
              "c2"
            ],
            "dims": [
              "case_id"
            ]
          }
        },
        "data_vars": {
          "plan": {
            "data": [
              "basic",
              "plus"
            ],
            "dims": [
              "case_id"
            ]
          },
          "tenure": {
            "data": [
              12.0,
              40.0
            ],
            "dims": [
              "case_id"
            ]
          }
        }
      },
      "label": "October leads"
    }
  ],
  "properties": {
    "inputs": {
      "$ref": "#/$defs/XrJsonDataset"
    },
    "label": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    }
  },
  "required": [
    "inputs"
  ],
  "title": "BatchSubmit",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
