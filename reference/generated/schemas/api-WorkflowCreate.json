{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "https://schemas.mapi.dev/v1/api-WorkflowCreate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``POST /v1/workflows``: a workflow with its first revision (the document).",
  "examples": [
    {
      "document": {
        "apiVersion": "mapi/v1",
        "inputs": {
          "data": {
            "type": "dataset"
          }
        },
        "kind": "Workflow",
        "metadata": {
          "name": "ts-readiness",
          "project": "growth"
        },
        "nodes": [
          {
            "id": "adf",
            "inputs": {
              "data": "inputs.data"
            },
            "use": "test.adf",
            "with": {
              "alpha": {
                "$param": "alpha"
              }
            }
          },
          {
            "id": "kpss",
            "inputs": {
              "data": "inputs.data"
            },
            "use": "test.kpss"
          },
          {
            "id": "wanders",
            "use": "branch.if",
            "with": {
              "condition": "nodes.adf.p_value >= params.alpha or nodes.kpss.reject"
            }
          },
          {
            "id": "diff",
            "inputs": {
              "data": "inputs.data"
            },
            "use": "transform.difference",
            "when": "wanders.then"
          },
          {
            "id": "order",
            "inputs": {
              "data": [
                "diff.data",
                "inputs.data"
              ]
            },
            "use": "search.arma_order"
          }
        ],
        "outputs": {
          "orders": "order.table"
        },
        "params": {
          "alpha": {
            "default": 0.05,
            "type": "number"
          }
        }
      },
      "message": "first version"
    }
  ],
  "properties": {
    "document": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The WorkflowSpec as JSON",
      "title": "Document"
    },
    "message": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "template": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Or a gallery template id",
      "title": "Template"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 262144,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Or YAML/JSON text",
      "title": "Text"
    }
  },
  "title": "WorkflowCreate",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
