{
  "$defs": {
    "ParamRow": {
      "additionalProperties": true,
      "properties": {
        "coords": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Coords",
          "type": "object"
        },
        "ess_bulk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ess Bulk"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Interval lower bound (hdi or ci)",
          "title": "Lower"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "prior": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior"
        },
        "r_hat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "R Hat"
        },
        "sd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sd"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "name"
      ],
      "title": "ParamRow",
      "type": "object"
    }
  },
  "$id": "https://schemas.mapi.dev/v1/explore-params.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "``params``: estimates with intervals (Bayesian posteriors or frequentist CIs).",
  "properties": {
    "caption_plain": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caption Plain"
    },
    "format": {
      "const": "mapi.model-explorer.params/v1",
      "default": "mapi.model-explorer.params/v1",
      "title": "Format",
      "type": "string"
    },
    "interval": {
      "default": "hdi_90",
      "description": "hdi_90, ci_95, ...",
      "maxLength": 32,
      "title": "Interval",
      "type": "string"
    },
    "omitted": {
      "default": 0,
      "minimum": 0,
      "title": "Omitted",
      "type": "integer"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ParamRow"
      },
      "maxItems": 5000,
      "title": "Rows",
      "type": "array"
    },
    "warnings_plain": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Warnings Plain",
      "type": "array"
    }
  },
  "title": "ParamTableView",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
