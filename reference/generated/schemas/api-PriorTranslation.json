    "PriorTranslationResult": {
      "description": "``priors.json`` of a ``translate_priors`` run.\n\n``priors`` are model-space priors in the plugin's ``settings.priors`` form (engine-neutral\n``{distribution, <params>, dims}`` dicts; per-channel parameters are lists in ``channels``\norder), to be written\nat :data:`PRIORS_POINTER`. ``coverage`` is the prior mass inside each stated range\n(close to the stated credibility when the translation is faithful).",
      "examples": [
        {
          "channels": [
            "tv",
            "search",
            "social"
          ],
          "coverage": {
            "search": 0.88,
            "social": 0.81,
            "tv": 0.79
          },
          "draws": 500,
          "format": "mapi.prior-translation/v1",
          "preview": {
            "contribution_share": {
              "tv": {
                "mean": 0.12,
                "quantiles": {
                  "0.05": 0.06,
                  "0.95": 0.19
                },
                "sd": 0.04
              }
            },
            "kpi_fan": {
              "coords": [
                "2026-01-04",
                "2026-01-11"
              ],
              "dim": "time",
              "observed": [
                101.0,
                99.5
              ],
              "quantiles": [
                0.05,
                0.5,
                0.95
              ],
              "units": "kEUR",
              "values": [
                [
                  80.0,
                  82.0
                ],
                [
                  100.0,
                  103.0
                ],
                [
                  125.0,
                  129.0
                ]
              ]
            },
            "roi": {
              "tv": {
                "mean": 2.6,
                "quantiles": {
                  "0.05": 1.5,
                  "0.5": 2.5,
                  "0.95": 4.1
                },
                "sd": 0.8
              }
            }
          },
          "priors": {
            "intercept": {
              "mu": 0.2,
              "sigma": 0.3
            },
            "roi": {
              "search": {
                "mu": 1.2,
                "sigma": 0.33
              },
              "social": {
                "mu": 0.1,
                "sigma": 0.5
              },
              "tv": {
                "mu": 0.9,
                "sigma": 0.38
              }
            }
          },
          "seed": 7
        }
      ],
      "properties": {
        "channels": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
