{
  "$defs": {
    "ErrorCode": {
      "description": "Stable error codes. See :data:`ERROR_INFO` for HTTP status and titles.",
      "enum": [
        "SCHEMA_INVALID",
        "SPEC_PARSE_ERROR",
        "PAYLOAD_TOO_LARGE",
        "UNSUPPORTED_API_VERSION",
        "REF_UNRESOLVED",
        "SETTINGS_INVALID",
        "BINDING_INVALID",
        "SPLIT_INVALID",
        "LEAKAGE_RISK",
        "DIM_POLICY_LOOSENED",
        "SCHEMA_DYNAMIC",
        "SIDE_TABLE_COVERAGE",
        "PLOT_UNSAFE",
        "UNSEEN_LEVELS",
        "COORD_NOT_ALLOWED",
        "HORIZON_EXCEEDS_FIT",
        "MISSING_FUTURE_COVARIATE",
        "NON_CONTIGUOUS_EXTENSION",
        "CAPABILITY_UNSUPPORTED",
        "RECURSIVE_UNSUPPORTED",
        "MODE_NOT_SUPPORTED",
        "QUOTA_EXCEEDED",
        "RATE_LIMITED",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "CONFLICT",
        "IDEMPOTENCY_CONFLICT",
        "PRECONDITION_FAILED",
        "USER_CODE_ERROR",
        "RESOURCE_EXHAUSTED",
        "INFRA_ERROR",
        "INTEGRITY_FAILURE",
        "TIMEOUT",
        "SANDBOX_VIOLATION",
        "CANCELLED",
        "INTERNAL_ERROR",
        "GUIDED_ANSWERS_INVALID",
        "BUSINESS_PRIORS_INVALID",
        "CALIBRATION_UNSUPPORTED",
        "IMPORT_UNSUPPORTED",
        "SCENARIO_OUT_OF_RANGE",
        "PROMOTION_BLOCKED",
        "OVERRIDE_REQUIRED",
        "WEBHOOK_URL_BLOCKED",
        "WEBHOOK_SIGNATURE_INVALID",
        "EMBED_NOT_ALLOWED",
        "LINK_EXPIRED",
        "EMAIL_NOT_ALLOWED",
        "TERMS_NOT_ACCEPTED",
        "EMAIL_NOT_VERIFIED",
        "IDENTITY_VERIFICATION_REQUIRED",
        "ABOUT_INCOMPLETE",
        "CHOOSER_ANSWER_INVALID",
        "WORKFLOW_INVALID",
        "EXPRESSION_INVALID",
        "EXPRESSION_ERROR",
        "NODE_UNKNOWN",
        "SCHEDULE_INVALID",
        "WORKFLOW_NOT_RUNNABLE",
        "POLICY_INVALID",
        "VALIDATION_TRANSITION_INVALID",
        "SELF_APPROVAL_FORBIDDEN",
        "NOT_VALIDATED",
        "EXPLORE_INVALID",
        "OPTIMIZE_INFEASIBLE"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "One problem found while validating a document, located by a JSON pointer.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "context": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Context",
          "type": "object"
        },
        "message": {
          "description": "Trusted, platform-authored text",
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        },
        "pointer": {
          "default": "",
          "description": "RFC 6901 JSON pointer into the submitted document",
          "title": "Pointer",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "error"
        },
        "suggested_action": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Action"
        },
        "untrusted_text": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "User/plugin-originated text; render as text only",
          "title": "Untrusted Text"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "JsonValue": {},
    "Severity": {
      "description": "How bad an :class:`Issue` is. Only ``error`` blocks submission.",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "Severity",
      "type": "string"
    },
    "WorkflowValidation": {
      "description": "``POST /v1/workflows:validate``: issues located by JSON pointers, the execution order\nand the resolved implementation of every node.",
      "examples": [
        {
          "issues": [
            {
              "code": "WORKFLOW_INVALID",
              "message": "node 'order' binds 'diff.series', but transform.difference has no output 'series' (it has: data)",
              "pointer": "/nodes/3/inputs/data",
              "severity": "error"
            }
          ],
          "order": [],
          "valid": false
        }
      ],
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "title": "Order",
          "type": "array"
        },
        "resolved": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "node id -> implementation ref (id@version)",
          "title": "Resolved",
          "type": "object"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "title": "WorkflowValidation",
      "type": "object"
    }
  },
  "$id": "https://schemas.mapi.dev/v1/api-WorkflowRevision.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An immutable, hashed revision; ``validation`` is its static check at save time\n(revisions with errors are stored but cannot run: ``WORKFLOW_NOT_RUNNABLE``).",
  "examples": [
    {
      "created_at": "2026-10-15T09:30:00Z",
      "document": {
        "apiVersion": "mapi/v1",
        "inputs": {
          "data": {
            "type": "dataset"
          }
        },
        "kind": "Workflow",
        "metadata": {
          "name": "ts-readiness",
          "project": "growth"
        },
        "nodes": [
          {
            "id": "adf",
            "inputs": {
              "data": "inputs.data"
            },
            "use": "test.adf",
            "with": {
              "alpha": {
                "$param": "alpha"
              }
            }
          },
          {
            "id": "kpss",
            "inputs": {
              "data": "inputs.data"
            },
            "use": "test.kpss"
          },
          {
            "id": "wanders",
            "use": "branch.if",
            "with": {
              "condition": "nodes.adf.p_value >= params.alpha or nodes.kpss.reject"
            }
          },
          {
            "id": "diff",
            "inputs": {
              "data": "inputs.data"
            },
            "use": "transform.difference",
            "when": "wanders.then"
          },
          {
            "id": "order",
            "inputs": {
              "data": [
                "diff.data",
                "inputs.data"
              ]
            },
            "use": "search.arma_order"
          }
        ],
        "outputs": {
          "orders": "order.table"
        },
        "params": {
          "alpha": {
            "default": 0.05,
            "type": "number"
          }
        }
      },
      "ref": "workflow://growth/ts-readiness@r2",
      "revision": 2,
      "spec_hash": "sha256:5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a",
      "validation": {
        "issues": [],
        "order": [
          "adf",
          "kpss",
          "wanders",
          "diff",
          "order"
        ],
        "valid": true
      },
      "workflow_id": "wf_01jaf3e1f2g3h4j5k6m7n8p9q0"
    }
  ],
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By"
    },
    "document": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Document",
      "type": "object"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "ref": {
      "description": "workflow://project/name@rN",
      "title": "Ref",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "spec_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Spec Hash",
      "type": "string"
    },
    "validation": {
      "$ref": "#/$defs/WorkflowValidation"
    },
    "workflow_id": {
      "examples": [
        "run_01jaf3q2x8m9v7k5h4g3f2e1d0"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,127}$",
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "revision",
    "ref",
    "document",
    "spec_hash",
    "validation",
    "created_at"
  ],
  "title": "WorkflowRevision",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
