{
  "$defs": {
    "BayesInsightMetadata": {
      "description": "BayesInsight's ``metadata.json`` (``{\"metadata\": {...}}`` is accepted too).\n\n``row_ids`` are the MFF key columns the model is indexed by (``Period`` always last);\nthe key columns *not* in ``row_ids`` are aggregated away and suffix variable names\n(``Promotion_Total_Total_Total``).",
      "properties": {
        "allowed_campaigns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 10000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Campaigns"
        },
        "allowed_creatives": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 10000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Creatives"
        },
        "allowed_geos": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 10000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Geos"
        },
        "allowed_outlets": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 10000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Outlets"
        },
        "allowed_products": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 10000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Products"
        },
        "end_period": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Period"
        },
        "necessary_variables": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 4096,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Necessary Variables"
        },
        "periodicity": {
          "default": "Weekly",
          "enum": [
            "Weekly",
            "Daily"
          ],
          "title": "Periodicity",
          "type": "string"
        },
        "row_ids": {
          "default": [
            "Period"
          ],
          "items": {
            "type": "string"
          },
          "title": "Row Ids",
          "type": "array"
        },
        "start_period": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Period"
        }
      },
      "title": "BayesInsightMetadata",
      "type": "object"
    },
    "DimMapping": {
      "additionalProperties": false,
      "description": "A dim of the dataset, read from one column of a tabular upload.",
      "examples": [
        {
          "column": "date",
          "spec": {
            "freq": "D",
            "kind": "time",
            "policy": "extend"
          }
        }
      ],
      "properties": {
        "column": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/DimSpec"
        }
      },
      "required": [
        "column",
        "spec"
      ],
      "title": "DimMapping",
      "type": "object"
    },
    "DimPolicy": {
      "description": "What may happen to a dim's coordinates at score time.",
      "enum": [
        "fixed",
        "extend",
        "new_levels"
      ],
      "title": "DimPolicy",
      "type": "string"
    },
    "DimSpec": {
      "additionalProperties": false,
      "description": "A dimension and its score-time policy.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "freq": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pandas-style frequency, e.g. 'W-SUN'",
          "title": "Freq"
        },
        "kind": {
          "enum": [
            "categorical",
            "time",
            "integer",
            "float",
            "index"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_extension": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Periods allowed past the fit",
          "title": "Max Extension"
        },
        "new_level_strategy": {
          "default": "error",
          "enum": [
            "error",
            "hyperprior",
            "pooled",
            "zero"
          ],
          "title": "New Level Strategy",
          "type": "string"
        },
        "ordered": {
          "default": false,
          "title": "Ordered",
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/$defs/DimPolicy",
          "default": "fixed"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DimSpec",
      "type": "object"
    },
    "IngestPreset": {
      "enum": [
        "none",
        "mff",
        "meridian",
        "bayesinsight"
      ],
      "title": "IngestPreset",
      "type": "string"
    },
    "MeridianColumns": {
      "additionalProperties": false,
      "description": "Google Meridian's ``CoordToColumns`` contract for a wide CSV/Parquet table.\n\n``media``/``media_spend`` (and ``reach``/``frequency``/``rf_spend``) are parallel lists:\nthe *i*-th column of each belongs to the *i*-th entry of ``media_channels``\n(``rf_channels``). ``geo`` is omitted for a national model; ``kpi_type`` says whether\nthe KPI is revenue (ROI in currency) or a count (``revenue_per_kpi`` converts it).",
      "examples": [
        {
          "controls": [
            "competitor_sales",
            "sentiment"
          ],
          "geo": "geo",
          "kpi": "conversions",
          "kpi_type": "non_revenue",
          "media": [
            "tv_impressions",
            "search_impressions"
          ],
          "media_channels": [
            "tv",
            "search"
          ],
          "media_spend": [
            "tv_spend",
            "search_spend"
          ],
          "population": "population",
          "revenue_per_kpi": "revenue_per_conversion",
          "time": "time"
        }
      ],
      "properties": {
        "controls": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Controls",
          "type": "array"
        },
        "freq": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "W",
          "description": "Time frequency (pandas alias)",
          "title": "Freq"
        },
        "frequency": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Frequency",
          "type": "array"
        },
        "geo": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "geo",
          "title": "Geo"
        },
        "kpi": {
          "default": "kpi",
          "maxLength": 256,
          "minLength": 1,
          "title": "Kpi",
          "type": "string"
        },
        "kpi_type": {
          "default": "revenue",
          "enum": [
            "revenue",
            "non_revenue"
          ],
          "title": "Kpi Type",
          "type": "string"
        },
        "media": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Media",
          "type": "array"
        },
        "media_channels": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Media Channels",
          "type": "array"
        },
        "media_spend": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Media Spend",
          "type": "array"
        },
        "non_media_treatments": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Non Media Treatments",
          "type": "array"
        },
        "organic_media": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Organic Media",
          "type": "array"
        },
        "population": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "reach": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Reach",
          "type": "array"
        },
        "revenue_per_kpi": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revenue Per Kpi"
        },
        "rf_channels": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Rf Channels",
          "type": "array"
        },
        "rf_spend": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Rf Spend",
          "type": "array"
        },
        "time": {
          "default": "time",
          "maxLength": 256,
          "minLength": 1,
          "title": "Time",
          "type": "string"
        }
      },
      "title": "MeridianColumns",
      "type": "object"
    },
    "MffOptions": {
      "additionalProperties": false,
      "description": "The MFF (\"model feature format\") long-table preset.\n\nOne row per ``(period, geography, product, campaign, outlet, creative, variable)`` with\nthe value in ``value_column``. ``Period`` becomes the time dim; the other key columns\nbecome dims only when they hold more than one distinct value; ``VariableName`` values\nbecome data variables.\n\n``combine`` joins several key columns into one dim (``{\"geo\": [\"Geography\", \"Product\"]}``\ngives labels such as ``US|Watches``) - a model with one panel dim can then fit a\ngeography x product panel. A combined dim is created even when it has a single label,\nso ``{\"geo\": [\"Geography\"]}`` keeps a national table's geo dim.",
      "properties": {
        "combine": {
          "description": "M3: dim -> key columns whose labels are joined ('|') into that one dim",
          "maxProperties": 4,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Combine",
          "type": "object"
        },
        "freq": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pandas offset alias; inferred when omitted",
          "title": "Freq"
        },
        "key_columns": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key column -> dim name",
          "title": "Key Columns",
          "type": "object"
        },
        "missing": {
          "default": "allow",
          "enum": [
            "forbid",
            "allow",
            "mask"
          ],
          "title": "Missing",
          "type": "string"
        },
        "period_column": {
          "default": "Period",
          "title": "Period Column",
          "type": "string"
        },
        "roles": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Variable -> role",
          "title": "Roles",
          "type": "object"
        },
        "time_dim": {
          "default": "date",
          "title": "Time Dim",
          "type": "string"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Variable -> units",
          "title": "Units",
          "type": "object"
        },
        "value_column": {
          "default": "VariableValue",
          "title": "Value Column",
          "type": "string"
        },
        "variable_column": {
          "default": "VariableName",
          "title": "Variable Column",
          "type": "string"
        }
      },
      "title": "MffOptions",
      "type": "object"
    },
    "Role": {
      "description": "What a variable means to a model.",
      "enum": [
        "target",
        "covariate",
        "media",
        "spend",
        "control",
        "index",
        "mask",
        "constant",
        "weight",
        "exposure"
      ],
      "title": "Role",
      "type": "string"
    },
    "VarMapping": {
      "additionalProperties": false,
      "description": "A data variable read from one column (dtype is inferred during ingest).",
      "examples": [
        {
          "column": "revenue",
          "role": "target",
          "units": "EUR"
        }
      ],
      "properties": {
        "column": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "missing": {
          "default": "forbid",
          "enum": [
            "forbid",
            "allow",
            "mask"
          ],
          "title": "Missing",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "covariate"
        },
        "units": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "column"
      ],
      "title": "VarMapping",
      "type": "object"
    },
    "WideVarMapping": {
      "additionalProperties": false,
      "description": "One variable read from several columns, one per label of ``dim`` (a wide table).\n\n``{\"dim\": \"channel\", \"columns\": {\"tv\": \"tv_spend\", \"search\": \"search_spend\"}}`` gives a\nvariable along ``channel`` (plus the table's other dims) with coords ``tv`` and\n``search``. Several wide variables may share a dim; their labels must then agree.",
      "examples": [
        {
          "columns": {
            "search": "search_spend",
            "social": "social_spend",
            "tv": "tv_spend"
          },
          "dim": "channel",
          "role": "spend",
          "units": "EUR"
        }
      ],
      "properties": {
        "columns": {
          "additionalProperties": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxProperties": 256,
          "minProperties": 1,
          "title": "Columns",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dim": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
          "title": "Dim",
          "type": "string"
        },
        "dim_spec": {
          "$ref": "#/$defs/DimSpec"
        },
        "missing": {
          "default": "forbid",
          "enum": [
            "forbid",
            "allow",
            "mask"
          ],
          "title": "Missing",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "covariate"
        },
        "units": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "dim",
        "columns"
      ],
      "title": "WideVarMapping",
      "type": "object"
    }
  },
  "$id": "https://schemas.mapi.dev/v1/api-IngestMapping.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "How an upload becomes a labelled dataset (Meridian ``CoordToColumns`` style).\n\nTabular formats need a mapping; ``zarr_zip``/``netcdf`` are self-describing and may omit\n``dims``/``vars``. Parsing happens only inside a sandboxed ingest run.\n\nWith the ``mff``/``bayesinsight`` presets the long table is first pivoted to one column\nper ``VariableName`` (plus ``Period`` and the key columns); ``vars`` and ``wide`` then\npick and rename those variables (``column`` = a ``VariableName`` value) and ``dims`` may\nrefine the dims the preset derives (``column`` = an MFF column). Without ``vars`` and\n``wide`` every variable is kept under its own name.",
  "examples": [
    {
      "dims": {
        "date": {
          "column": "date",
          "spec": {
            "freq": "D",
            "kind": "time",
            "policy": "extend"
          }
        },
        "market": {
          "column": "market",
          "spec": {
            "kind": "categorical"
          }
        }
      },
      "format": "csv",
      "vars": {
        "revenue_local": {
          "column": "revenue",
          "role": "target",
          "units": "local"
        },
        "spend_local": {
          "column": "spend",
          "role": "spend",
          "units": "local"
        }
      }
    },
    {
      "dims": {
        "market": {
          "column": "market",
          "spec": {
            "kind": "categorical"
          }
        },
        "week": {
          "column": "week",
          "spec": {
            "freq": "W-SUN",
            "kind": "time",
            "policy": "extend"
          }
        }
      },
      "format": "csv",
      "vars": {
        "revenue": {
          "column": "revenue",
          "role": "target",
          "units": "EUR"
        }
      },
      "wide": {
        "spend": {
          "columns": {
            "search": "search_spend",
            "social": "social_spend",
            "tv": "tv_spend"
          },
          "dim": "channel",
          "role": "spend",
          "units": "EUR"
        }
      }
    },
    {
      "format": "mff",
      "mff": {
        "freq": "W-MON"
      },
      "preset": "mff"
    },
    {
      "format": "parquet",
      "meridian": {
        "kpi": "revenue",
        "media": [
          "tv_impressions"
        ],
        "media_channels": [
          "tv"
        ],
        "media_spend": [
          "tv_spend"
        ]
      },
      "preset": "meridian"
    }
  ],
  "properties": {
    "bayesinsight": {
      "anyOf": [
        {
          "$ref": "#/$defs/BayesInsightMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "BayesInsight's metadata.json (the bayesinsight preset)"
    },
    "dims": {
      "additionalProperties": {
        "$ref": "#/$defs/DimMapping"
      },
      "maxProperties": 32,
      "title": "Dims",
      "type": "object"
    },
    "format": {
      "enum": [
        "csv",
        "parquet",
        "mff",
        "zarr_zip",
        "netcdf"
      ],
      "title": "Format",
      "type": "string"
    },
    "layout": {
      "default": "dense",
      "enum": [
        "dense",
        "long"
      ],
      "title": "Layout",
      "type": "string"
    },
    "meridian": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeridianColumns"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The meridian preset's columns"
    },
    "mff": {
      "anyOf": [
        {
          "$ref": "#/$defs/MffOptions"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Options of the mff/bayesinsight presets"
    },
    "preset": {
      "$ref": "#/$defs/IngestPreset",
      "default": "none",
      "description": "M3: a file contract instead of (or refined by) the column mapping"
    },
    "vars": {
      "additionalProperties": {
        "$ref": "#/$defs/VarMapping"
      },
      "maxProperties": 1024,
      "title": "Vars",
      "type": "object"
    },
    "wide": {
      "additionalProperties": {
        "$ref": "#/$defs/WideVarMapping"
      },
      "description": "M3: variables read from one column per label of a dim (wide tables)",
      "maxProperties": 64,
      "title": "Wide",
      "type": "object"
    }
  },
  "required": [
    "format"
  ],
  "title": "IngestMapping",
  "type": "object",
  "x-mapi-contract-version": "0.1"
}
