{
  "$defs": {
    "DimMapping": {
      "additionalProperties": false,
      "description": "A dim of the dataset, read from one column of a tabular upload.",
      "examples": [
        {
          "column": "date",
          "spec": {
            "freq": "D",
            "kind": "time",
            "policy": "extend"
          }
        }
      ],
      "properties": {
        "column": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/DimSpec"
        }
      },
      "required": [
        "column",
        "spec"
      ],
      "title": "DimMapping",
      "type": "object"
    },
    "DimPolicy": {
      "description": "What may happen to a dim's coordinates at score time.",
      "enum": [
        "fixed",
        "extend",
        "new_levels"
      ],
      "title": "DimPolicy",
      "type": "string"
    },
    "DimSpec": {
      "additionalProperties": false,
      "description": "A dimension and its score-time policy.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "freq": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pandas-style frequency, e.g. 'W-SUN'",
          "title": "Freq"
        },
        "kind": {
          "enum": [
            "categorical",
            "time",
            "integer",
            "float",
            "index"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_extension": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Periods allowed past the fit",
          "title": "Max Extension"
        },
        "new_level_strategy": {
          "default": "error",
          "enum": [
            "error",
            "hyperprior",
            "pooled",
            "zero"
          ],
          "title": "New Level Strategy",
          "type": "string"
        },
        "ordered": {
          "default": false,
          "title": "Ordered",
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/$defs/DimPolicy",
          "default": "fixed"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DimSpec",
      "type": "object"
    },
    "Hdf5Coord": {
      "additionalProperties": false,
      "description": "The coordinate of dim ``dim`` in node ``node`` of a raw HDF5 upload (M4).\n\nExactly one source: ``path`` (a 1-D HDF5 dataset holding the labels), or ``start`` with\nan optional ``step`` (a range: numbers, or a date and a pandas frequency such as\n``\"2024-01-01\"`` + ``\"W-MON\"``), or neither (an integer index ``0..n-1``). ``spec``\noverrides the inferred :class:`~mapi_spec.schema.DimSpec`.",
      "examples": [
        {
          "dim": "row",
          "spec": {
            "kind": "float",
            "ordered": true
          },
          "start": 0.0,
          "step": 0.05
        },
        {
          "dim": "date",
          "path": "/axes/date",
          "spec": {
            "kind": "time",
            "policy": "extend"
          }
        }
      ],
      "properties": {
        "dim": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
          "title": "Dim",
          "type": "string"
        },
        "node": {
          "default": "/",
          "pattern": "^/(?:[A-Za-z_][A-Za-z0-9_.\\-]{0,63}(?:/[A-Za-z_][A-Za-z0-9_.\\-]{0,63}){0,7})?$",
          "title": "Node",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^/[^\\x00]{1,1024}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        }
      },
      "required": [
        "dim"
      ],
      "title": "Hdf5Coord",
      "type": "object"
    },
    "Hdf5Mapping": {
      "additionalProperties": false,
      "description": "How a raw HDF5 upload becomes a (tree) dataset (M4): which arrays become which\nvariables of which node, with which dims and coords. Arrays that are not mapped are\nreported in one warning, never read.",
      "examples": [
        {
          "coords": [
            {
              "dim": "row",
              "spec": {
                "kind": "float",
                "ordered": true
              },
              "start": 0.0,
              "step": 0.05
            }
          ],
          "vars": [
            {
              "dims": [
                "row",
                "col"
              ],
              "name": "image",
              "node": "/",
              "path": "/observations/image",
              "units": "counts"
            },
            {
              "dims": [
                "prow",
                "pcol"
              ],
              "name": "psf",
              "node": "/psf",
              "path": "/psf/kernel"
            }
          ]
        }
      ],
      "properties": {
        "coords": {
          "items": {
            "$ref": "#/$defs/Hdf5Coord"
          },
          "maxItems": 64,
          "title": "Coords",
          "type": "array"
        },
        "vars": {
          "items": {
            "$ref": "#/$defs/Hdf5Var"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Vars",
          "type": "array"
        }
      },
      "required": [
        "vars"
      ],
      "title": "Hdf5Mapping",
      "type": "object"
    },
    "Hdf5Var": {
      "additionalProperties": false,
      "description": "A data variable read from one HDF5 dataset of a raw HDF5 upload (M4).\n\n``dims`` names the array's axes in order (its length must equal the array's ``ndim``;\nthe sandbox checks it). The variable is stored as ``name`` in tree node ``node``.",
      "examples": [
        {
          "dims": [
            "row",
            "col"
          ],
          "name": "image",
          "node": "/",
          "path": "/observations/image",
          "units": "counts"
        }
      ],
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dims": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Dims",
          "type": "array"
        },
        "missing": {
          "default": "forbid",
          "enum": [
            "forbid",
            "allow",
            "mask"
          ],
          "title": "Missing",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "node": {
          "default": "/",
          "pattern": "^/(?:[A-Za-z_][A-Za-z0-9_.\\-]{0,63}(?:/[A-Za-z_][A-Za-z0-9_.\\-]{0,63}){0,7})?$",
          "title": "Node",
          "type": "string"
        },
        "path": {
          "pattern": "^/[^\\x00]{1,1024}$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "covariate"
        },
        "units": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "path",
        "name"
      ],
      "title": "Hdf5Var",
      "type": "object"
    },
    "ImageFolderOptions": {
      "additionalProperties": false,
      "description": "How a zip of images and a manifest table becomes ``pixels(image, y, x, channel)``.\n\nThe manifest has one row per image: the image path in the zip and, optionally, an id, a\nclass label and a train/test split. The images must have 8 bits per channel and one\nsize, unless ``size`` resizes them. Every byte is decoded inside the sandboxed ingest run.",
      "examples": [
        {
          "label_column": "class",
          "manifest": "manifest.csv",
          "path_column": "file",
          "split_column": "split"
        },
        {
          "id_column": "id",
          "label_column": "label",
          "manifest": "labels.parquet",
          "max_images": 5000,
          "mode": "rgb",
          "resize": "crop",
          "size": [
            32,
            32
          ]
        }
      ],
      "properties": {
        "columns": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Other columns kept as coords (default: all others)",
          "title": "Columns"
        },
        "dim": {
          "default": "image",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
          "title": "Dim",
          "type": "string"
        },
        "id_column": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique labels of the image dim (default: the row number)",
          "title": "Id Column"
        },
        "label_column": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Class labels: the text variable 'label(image)', role target",
          "title": "Label Column"
        },
        "manifest": {
          "default": "manifest.csv",
          "description": "Path of the manifest in the zip",
          "maxLength": 256,
          "minLength": 1,
          "title": "Manifest",
          "type": "string"
        },
        "max_images": {
          "default": 20000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Images",
          "type": "integer"
        },
        "mode": {
          "default": "auto",
          "description": "auto: rgb when an image has colour, else gray",
          "enum": [
            "auto",
            "gray",
            "rgb"
          ],
          "title": "Mode",
          "type": "string"
        },
        "path_column": {
          "default": "path",
          "description": "Image paths relative to the zip root",
          "maxLength": 256,
          "minLength": 1,
          "title": "Path Column",
          "type": "string"
        },
        "resize": {
          "default": "stretch",
          "description": "How images are resized (only with size)",
          "enum": [
            "stretch",
            "crop",
            "pad"
          ],
          "title": "Resize",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(height, width) to resize every image to; each 1..4096",
          "title": "Size"
        },
        "split_column": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Train/test assignment: the text coord 'split(image)'",
          "title": "Split Column"
        },
        "var": {
          "default": "pixels",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
          "title": "Var",
          "type": "string"
        }
      },
      "title": "ImageFolderOptions",
      "type": "object"
    },
    "IngestMapping": {
      "additionalProperties": false,
      "description": "How an upload becomes a labelled dataset (Meridian ``CoordToColumns`` style).\n\nTabular formats need a mapping; ``zarr_zip``/``netcdf`` are self-describing and may omit\n``dims``/``vars`` (with groups, they rename/select per node by name). A raw ``hdf5``\nfile (M4) needs ``hdf5`` (:class:`Hdf5Mapping`) instead of ``dims``/``vars``. Parsing\nhappens only inside a sandboxed ingest run.\n\nWith the ``mff`` preset the long table is first pivoted to one column\nper ``VariableName`` (plus ``Period`` and the key columns); ``vars`` and ``wide`` then\npick and rename those variables (``column`` = a ``VariableName`` value) and ``dims`` may\nrefine the dims the preset derives (``column`` = an MFF column). Without ``vars`` and\n``wide`` every variable is kept under its own name.",
      "examples": [
        {
          "dims": {
            "date": {
              "column": "date",
              "spec": {
                "freq": "D",
                "kind": "time",
                "policy": "extend"
              }
            },
            "market": {
              "column": "market",
              "spec": {
                "kind": "categorical"
              }
            }
          },
          "format": "csv",
          "vars": {
            "revenue_local": {
              "column": "revenue",
              "role": "target",
              "units": "local"
            },
            "spend_local": {
              "column": "spend",
              "role": "spend",
              "units": "local"
            }
          }
        },
        {
          "dims": {
            "market": {
              "column": "market",
              "spec": {
                "kind": "categorical"
              }
            },
            "week": {
              "column": "week",
              "spec": {
                "freq": "W-SUN",
                "kind": "time",
                "policy": "extend"
              }
            }
          },
          "format": "csv",
          "vars": {
            "revenue": {
              "column": "revenue",
              "role": "target",
              "units": "EUR"
            }
          },
          "wide": {
            "spend": {
              "columns": {
                "search": "search_spend",
                "social": "social_spend",
                "tv": "tv_spend"
              },
              "dim": "channel",
              "role": "spend",
              "units": "EUR"
            }
          }
        },
        {
          "format": "mff",
          "mff": {
            "freq": "W-MON"
          },
          "preset": "mff"
        },
        {
          "format": "parquet",
          "meridian": {
            "kpi": "revenue",
            "media": [
              "tv_impressions"
            ],
            "media_channels": [
              "tv"
            ],
            "media_spend": [
              "tv_spend"
            ]
          },
          "preset": "meridian"
        },
        {
          "format": "hdf5",
          "hdf5": {
            "coords": [
              {
                "dim": "row",
                "spec": {
                  "kind": "float",
                  "ordered": true
                },
                "start": 0.0,
                "step": 0.05
              }
            ],
            "vars": [
              {
                "dims": [
                  "row",
                  "col"
                ],
                "name": "image",
                "node": "/",
                "path": "/observations/image",
                "units": "counts"
              },
              {
                "dims": [
                  "prow",
                  "pcol"
                ],
                "name": "psf",
                "node": "/psf",
                "path": "/psf/kernel"
              }
            ]
          }
        },
        {
          "format": "image_folder",
          "images": {
            "label_column": "class",
            "manifest": "manifest.csv",
            "path_column": "file",
            "split_column": "split"
          }
        },
        {
          "format": "safetensors",
          "weights": {
            "max_parameters": 50000000
          }
        }
      ],
      "properties": {
        "dims": {
          "additionalProperties": {
            "$ref": "#/$defs/DimMapping"
          },
          "maxProperties": 32,
          "title": "Dims",
          "type": "object"
        },
        "format": {
          "enum": [
            "csv",
            "parquet",
            "mff",
            "zarr_zip",
            "netcdf",
            "hdf5",
            "image_folder",
            "safetensors"
          ],
          "title": "Format",
          "type": "string"
        },
        "hdf5": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hdf5Mapping"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "M4: the arrays, dims and coords of a raw HDF5 upload (format 'hdf5')"
        },
        "images": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageFolderOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.14: options of an 'image_folder' upload (defaults when left out)"
        },
        "layout": {
          "default": "dense",
          "enum": [
            "dense",
            "long"
          ],
          "title": "Layout",
          "type": "string"
        },
        "meridian": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeridianColumns"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The meridian preset's columns"
        },
        "mff": {
          "anyOf": [
            {
              "$ref": "#/$defs/MffOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Options of the mff preset"
        },
        "preset": {
          "$ref": "#/$defs/IngestPreset",
          "default": "none",
          "description": "M3: a file contract instead of (or refined by) the column mapping"
        },
        "vars": {
          "additionalProperties": {
            "$ref": "#/$defs/VarMapping"
          },
          "maxProperties": 1024,
          "title": "Vars",
          "type": "object"
        },
        "weights": {
          "anyOf": [
            {
              "$ref": "#/$defs/WeightsOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.15: options of a 'safetensors' upload (defaults when left out)"
        },
        "wide": {
          "additionalProperties": {
            "$ref": "#/$defs/WideVarMapping"
          },
          "description": "M3: variables read from one column per label of a dim (wide tables)",
          "maxProperties": 64,
          "title": "Wide",
          "type": "object"
        }
      },
      "required": [
        "format"
      ],
      "title": "IngestMapping",
      "type": "object"
    },
    "IngestPreset": {
      "enum": [
        "none",
        "mff",
        "meridian"
      ],
      "title": "IngestPreset",
      "type": "string"
    },
    "JsonValue": {},
    "MeridianColumns": {
      "additionalProperties": false,
      "description": "Google Meridian's ``CoordToColumns`` contract for a wide CSV/Parquet table.\n\n``media``/``media_spend`` (and ``reach``/``frequency``/``rf_spend``) are parallel lists:\nthe *i*-th column of each belongs to the *i*-th entry of ``media_channels``\n(``rf_channels``). ``geo`` is omitted for a national model; ``kpi_type`` says whether\nthe KPI is revenue (ROI in currency) or a count (``revenue_per_kpi`` converts it).",
      "examples": [
        {
          "controls": [
            "competitor_sales",
            "sentiment"
          ],
          "geo": "geo",
          "kpi": "conversions",
          "kpi_type": "non_revenue",
          "media": [
            "tv_impressions",
            "search_impressions"
          ],
          "media_channels": [
            "tv",
            "search"
          ],
          "media_spend": [
            "tv_spend",
            "search_spend"
          ],
          "population": "population",
          "revenue_per_kpi": "revenue_per_conversion",
          "time": "time"
        }
      ],
      "properties": {
        "controls": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Controls",
          "type": "array"
        },
        "freq": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "W",
          "description": "Time frequency (pandas alias)",
          "title": "Freq"
        },
        "frequency": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Frequency",
          "type": "array"
        },
        "geo": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "geo",
          "title": "Geo"
        },
        "kpi": {
          "default": "kpi",
          "maxLength": 256,
          "minLength": 1,
          "title": "Kpi",
          "type": "string"
        },
        "kpi_type": {
          "default": "revenue",
          "enum": [
            "revenue",
            "non_revenue"
          ],
          "title": "Kpi Type",
          "type": "string"
        },
        "media": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Media",
          "type": "array"
        },
        "media_channels": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Media Channels",
          "type": "array"
        },
        "media_spend": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Media Spend",
          "type": "array"
        },
        "non_media_treatments": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Non Media Treatments",
          "type": "array"
        },
        "organic_media": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
