{
  "$id": "https://schemas.mapi.dev/v1/api-ScoreSummaryTable.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One output variable's summary as a table: the coordinate columns (one per dim), then\none column per statistic (``mean``, ``hdi_90_lower``, ...). Dates are ISO text.\n``period``: the variable is a circular output (``OutputDecl.circular``), summarised on the\ncircle (see the field).",
  "examples": [
    {
      "columns": [
        "geo",
        "time",
        "mean",
        "hdi_90_lower",
        "hdi_90_upper"
      ],
      "rows": [
        [
          "de",
          "2026-01-05",
          1520.4,
          1402.1,
          1633.9
        ]
      ],
      "variable": "revenue"
    }
  ],
  "properties": {
    "columns": {
      "items": {
        "type": "string"
      },
      "maxItems": 256,
      "title": "Columns",
      "type": "array"
    },
    "period": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set for a circular output (an angle that wraps at one turn, in the output's units): the statistics are on the circle. `mean` is the circular mean, the intervals are centred on it, and every value is in [0, period). An interval with lower > upper crosses the seam (from 350 to 10 degrees)",
      "title": "Period"
    },
    "rows": {
      "items": {
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "array"
      },
      "title": "Rows",
      "type": "array"
    },
    "variable": {
      "maxLength": 256,
      "title": "Variable",
      "type": "string"
    }
  },
  "required": [
    "variable",
    "columns",
    "rows"
  ],
  "title": "ScoreSummaryTable",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
