{
  "$defs": {
    "ReadoutHeader": {
      "description": "A readout without its snapshot (lists, ``202`` answers while it is being built).\n\n``refit_status`` is the state of the refit request made with an actuals upload (\u00a710.4),\nshown to the uploader and the analysts.",
      "examples": [
        {
          "created_at": "2026-10-15T09:30:00Z",
          "kind": "refresh",
          "model_ref": "model://growth/eu-geo-mmm@v3",
          "model_version_id": "mv_01jaf3e1f2g3h4j5k6m7n8p9q0",
          "period": [
            "2026-10-12",
            "2026-10-18"
          ],
          "ready_at": "2026-10-15T09:30:00Z",
          "seq": 12,
          "status": "ready",
          "title": "Week ending 18/10/2026",
          "trigger": "workflow",
          "visibility": "published"
        },
        {
          "created_at": "2026-10-15T09:30:00Z",
          "kind": "scenario",
          "model_ref": "model://growth/eu-geo-mmm@v3",
          "model_version_id": "mv_01jaf3e1f2g3h4j5k6m7n8p9q0",
          "seq": 13,
          "status": "running",
          "title": "TV \u221220 %, search +30 %",
          "trigger": "whatif",
          "visibility": "private"
        }
      ],
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "endpoint_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Revision"
        },
        "kind": {
          "enum": [
            "baseline",
            "refresh",
            "scenario",
            "actuals",
            "prediction",
            "batch"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mine": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the caller made this readout (its own tried case, file or upload); set on the readout list and reads, null where the caller is not known",
          "title": "Mine"
        },
        "model_ref": {
          "maxLength": 512,
          "title": "Model Ref",
          "type": "string"
        },
        "model_version_id": {
          "maxLength": 128,
          "title": "Model Version Id",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "format": "date",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "ready_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ready At"
        },
        "refit_status": {
          "anyOf": [
            {
              "enum": [
                "open",
                "approved",
                "rejected",
                "superseded",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refit Status"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "materialising",
            "ready",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        },
        "trigger": {
          "enum": [
            "publish",
            "manual",
            "whatif",
            "actuals",
            "workflow",
            "endpoint",
            "scenario_rows",
            "batch"
          ],
          "title": "Trigger",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "published",
            "private",
            "pending_review",
            "hidden"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "kind",
        "trigger",
        "visibility",
        "status",
        "title",
        "model_version_id",
        "model_ref",
        "created_at"
      ],
      "title": "ReadoutHeader",
      "type": "object"
    }
  },
  "$id": "https://schemas.mapi.dev/v1/api-DashboardSummary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One row of ``GET /v1/dashboards``: no spec, no people (clients list with it too).",
  "examples": [
    {
      "client_name": "Acme Retail",
      "id": "dsh_01jaf3r1s2t3v4w5x6y7z8a9b0",
      "latest_readout": {
        "created_at": "2026-10-15T09:30:00Z",
        "kind": "refresh",
        "model_ref": "model://growth/eu-geo-mmm@v3",
        "model_version_id": "mv_01jaf3e1f2g3h4j5k6m7n8p9q0",
        "period": [
          "2026-10-12",
          "2026-10-18"
        ],
        "ready_at": "2026-10-15T09:30:00Z",
        "seq": 12,
        "status": "ready",
        "title": "Week ending 18/10/2026",
        "trigger": "workflow",
        "visibility": "published"
      },
      "live_inputs": "ok",
      "name": "acme-weekly",
      "period_label": "week",
      "status": "published",
      "title": "Weekly media results",
      "updated_at": "2026-10-15T09:30:00Z"
    }
  ],
  "properties": {
    "client_name": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Name"
    },
    "id": {
      "examples": [
        "run_01jaf3q2x8m9v7k5h4g3f2e1d0"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "latest_readout": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReadoutHeader"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "live_inputs": {
      "default": "ok",
      "enum": [
        "ok",
        "paused"
      ],
      "title": "Live Inputs",
      "type": "string"
    },
    "name": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$",
      "title": "Name",
      "type": "string"
    },
    "period_label": {
      "default": "week",
      "enum": [
        "week",
        "month",
        "quarter",
        "year",
        "day",
        "period",
        "case"
      ],
      "title": "Period Label",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "title",
    "status",
    "updated_at"
  ],
  "title": "DashboardSummary",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
