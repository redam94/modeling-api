{
  "$defs": {
    "JsonValue": {},
    "ResourceClass": {
      "description": "Executor resource class. Ordered: ``S < M < L < XL < GPU``.\n\n``GPU`` is the last (highest-rank) member on purpose: a quota whose\n``max_resource_class`` is below it refuses it, and :meth:`next_up` never offers it.",
      "enum": [
        "S",
        "M",
        "L",
        "XL",
        "GPU"
      ],
      "title": "ResourceClass",
      "type": "string"
    }
  },
  "$id": "https://schemas.mapi.dev/v1/api-WorkflowRunCreate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``POST /v1/workflows/{workflow_id}/runs`` (``Idempotency-Key``).",
  "examples": [
    {
      "inputs": {
        "data": "dataset://growth/weekly_sales@v4"
      },
      "params": {
        "alpha": 0.05
      }
    }
  ],
  "properties": {
    "experiment_id": {
      "anyOf": [
        {
          "examples": [
            "run_01jaf3q2x8m9v7k5h4g3f2e1d0"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Experiment of the workflow run and of every run it starts (v0.14; not an archived one). Default: the experiment of the parent run, if any",
      "title": "Experiment Id"
    },
    "inputs": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "input name -> reference",
      "maxProperties": 16,
      "title": "Inputs",
      "type": "object"
    },
    "params": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "maxProperties": 64,
      "title": "Params",
      "type": "object"
    },
    "resource_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default: the latest revision",
      "title": "Revision"
    },
    "use_cache": {
      "default": true,
      "description": "Reuse unchanged node results",
      "title": "Use Cache",
      "type": "boolean"
    }
  },
  "title": "WorkflowRunCreate",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
