  "$id": "https://schemas.mapi.dev/v1/api-AuditEvent.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One audit row. ``tenant_id`` is ``None`` for platform-level actions.",
  "examples": [
    {
      "action": "token.create",
      "actor_id": "usr_01jaf3a9b8c7d6e5f4g3h2j1k0",
      "actor_kind": "user",
      "details": {
        "expires_in_days": 30,
        "scopes": [
          "score:geo-mmm-prod"
        ]
      },
      "id": "aud_01jaf3w1x2y3z4a5b6c7d8e9f0",
      "ip_hash": "hmac-sha256:0f1e2d3c4b5a69788796a5b4c3d2e1f0",
      "outcome": "success",
      "project_id": "growth",
      "request_id": "req-7f3a",
      "resource_id": "tok_01jaf3r1s2t3v4w5x6y7z8a9b0",
      "resource_kind": "token",
      "tenant_id": "acme",
      "ts": "2026-10-15T09:30:00Z",
      "user_agent_hash": "hmac-sha256:a1b2c3d4e5f60718293a4b5c6d7e8f90"
    },
    {
      "action": "quota.denied",
      "actor_id": "tok_01jaf3r1s2t3v4w5x6y7z8a9b0",
      "actor_kind": "token",
      "code": "QUOTA_EXCEEDED",
      "details": {
        "limit_name": "vcpu_seconds_per_day",
        "scope": "tenant"
      },
      "id": "aud_01jaf3w9x8y7z6a5b4c3d2e1f0",
      "outcome": "denied",
      "project_id": "growth",
      "resource_kind": "run",
      "tenant_id": "acme",
      "token_id": "tok_01jaf3r1s2t3v4w5x6y7z8a9b0",
      "ts": "2026-10-15T09:30:00Z"
    }
  ],
  "properties": {
    "action": {
      "$ref": "#/$defs/AuditAction"
    },
    "actor_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor Id"
    },
    "actor_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrincipalKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None: unauthenticated caller"
    },
    "code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Problem code of a denial or error"
    },
    "details": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Details",
      "type": "object"
    },
    "id": {
      "examples": [
        "run_01jaf3q2x8m9v7k5h4g3f2e1d0"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "ip_hash": {
      "anyOf": [
        {
          "pattern": "^hmac-sha256:[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ip Hash"
    },
    "operator": {
      "default": false,
      "description": "The actor acted as a platform operator",
      "title": "Operator",
      "type": "boolean"
    },
    "outcome": {
      "$ref": "#/$defs/AuditOutcome"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "request_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "resource_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Id"
    },
    "resource_kind": {
      "$ref": "#/$defs/ResourceKind"
    },
    "tenant_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenant Id"
    },
    "token_id": {
      "anyOf": [
        {
          "examples": [
            "run_01jaf3q2x8m9v7k5h4g3f2e1d0"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when the actor used an API token",
      "title": "Token Id"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "user_agent_hash": {
      "anyOf": [
        {
          "pattern": "^hmac-sha256:[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Agent Hash"
    }
  },
  "required": [
    "id",
    "ts",
    "action",
    "resource_kind",
    "outcome"
  ],
  "title": "AuditEvent",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
