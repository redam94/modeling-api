{
  "$defs": {
    "Histogram": {
      "additionalProperties": true,
      "properties": {
        "counts": {
          "items": {
            "type": "integer"
          },
          "maxItems": 201,
          "minItems": 1,
          "title": "Counts",
          "type": "array"
        },
        "edges": {
          "items": {
            "type": "number"
          },
          "maxItems": 202,
          "minItems": 2,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "edges",
        "counts"
      ],
      "title": "Histogram",
      "type": "object"
    },
    "VarDistribution": {
      "additionalProperties": true,
      "properties": {
        "facet": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Facet",
          "type": "object"
        },
        "histogram": {
          "anyOf": [
            {
              "$ref": "#/$defs/Histogram"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kurtosis": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kurtosis"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "quantiles": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 16,
          "title": "Quantiles",
          "type": "object"
        },
        "sd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sd"
        },
        "skew": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skew"
        },
        "var": {
          "maxLength": 256,
          "title": "Var",
          "type": "string"
        },
        "zero_share": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zero Share"
        }
      },
      "required": [
        "var",
        "n"
      ],
      "title": "VarDistribution",
      "type": "object"
    }
  },
  "$id": "https://schemas.mapi.dev/v1/explore-distributions.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "``distributions``: a histogram and summary statistics per variable.",
  "properties": {
    "caption_plain": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caption Plain"
    },
    "format": {
      "const": "mapi.data-explorer.distributions/v1",
      "default": "mapi.data-explorer.distributions/v1",
      "title": "Format",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/VarDistribution"
      },
      "maxItems": 200,
      "title": "Items",
      "type": "array"
    },
    "node": {
      "anyOf": [
        {
          "pattern": "^/(?:[A-Za-z_][A-Za-z0-9_.\\-]{0,63}(?:/[A-Za-z_][A-Za-z0-9_.\\-]{0,63}){0,7})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "M4: the node of a tree dataset the view describes (absent for a flat dataset)",
      "title": "Node"
    },
    "warnings_plain": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Warnings Plain",
      "type": "array"
    }
  },
  "title": "DistributionsView",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
