{
  "$id": "https://schemas.mapi.dev/v1/api-WhatIfRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Spend multipliers per channel (``1`` = the current plan; missing channels stay at 1).",
  "examples": [
    {
      "multipliers": {
        "search": 1.3,
        "tv": 0.8
      }
    }
  ],
  "properties": {
    "multipliers": {
      "maxProperties": 40,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_.\\-]{0,127}$": {
          "type": "number"
        }
      },
      "title": "Multipliers",
      "type": "object"
    }
  },
  "title": "WhatIfRequest",
  "type": "object",
  "x-mapi-contract-version": "0.2"
}
