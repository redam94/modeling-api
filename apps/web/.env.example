# Base URL of the modeling-api control plane (no trailing slash). The API must allow this
# app's origin via CORS (MAPI_WEB_ORIGIN on the server).
VITE_API_BASE=http://127.0.0.1:8000

# Origin serving apps/plot-sandbox. It MUST differ from this app's origin (plan §10.3).
VITE_PLOTS_ORIGIN=http://127.0.0.1:5174

# Origins of signed storage URLs the browser fetches/uploads to (CSP connect-src), comma separated.
VITE_STORAGE_ORIGINS=http://127.0.0.1:4443
