   "spec_template": {
    "apiVersion": "mapi/v1",
    "data": {
     "bind": {
      "dims": {
       "channel": "channel",
       "geo": "{{geo}}",
       "time": "{{date}}"
      },
      "vars": {
       "spend": "spend",
       "y": "{{kpi}}"
      }
     },
     "dataset": "{{dataset}}",
     "split": {
      "after_step": "weekly",
      "dim": "time",
      "kind": "time_holdout",
      "last": "{{holdout_periods}}"
     }
    },
    "evaluate": {
     "metrics": [
      "mape",
      "coverage_90"
     ]
    },
    "execution": {
     "resource_class": "M",
     "timeout": "45m"
    },
    "kind": "ModelSpec",
    "metadata": {
     "labels": {
      "family": "mmm",
      "guided": "geo_mmm"
     },
     "name": "{{name}}",
     "project": "{{project}}"
    },
    "model": {
     "fit": {
      "chains": 4,
      "draws": 1000,
      "mode": "evaluate_then_refit",
      "seed": 20261015,
      "target_accept": 0.95,
      "tune": 1000
     },
     "settings": {
      "adstock": {
       "kind": "geometric",
       "l_max": 6
      },
      "pooling": "partial",
      "saturation": {
       "kind": "logistic"
      }
     },
     "use": "mmm.hierarchical_geo@^1"
    },
    "outputs": {
     "derived": [
      "contributions",
      "response_curves",
      "marginal_cost"
     ],
     "plots": [
      "core.ppc_fan",
      "core.convergence",
      "mmm.decomposition",
      "mmm.response_curves"
     ],
     "ui_draws": 300
    },
    "pipeline": [
     {
      "id": "weekly",
      "use": "core.resample@^1",
      "with": {
       "dim": "time",
       "freq": "W-SUN",
       "full_periods_only": true,
       "how": "sum"
      }
     },
     {
      "id": "scale_spend",
      "use": "core.mean_scale@^1",
      "with": {
       "over": [
        "time"
       ],
       "unseen_levels": "pooled",
       "vars": [
        "spend"
       ]
      }
     },
     {
      "id": "scale_y",
      "use": "core.mean_scale@^1",
      "with": {
       "over": [
        "time"
       ],
       "unseen_levels": "pooled",
       "vars": [
        "y"
       ]
      }
     },
     {
      "id": "lags",
      "use": "core.lag_tensor@^1",
      "with": {
       "along": "time",
       "l_max": 6,
       "pad": "first",
       "vars": [
        "spend"
       ],
       "within": [
        "geo"
       ]
      }
     },
     {
      "id": "season",
      "use": "core.fourier@^1",
      "with": {
       "along": "time",
       "order": 3,
       "out": "fourier",
       "period": 52.18
      }
     }
    ]
   },
