{
  "name": "@mapi/web",
  "private": true,
  "version": "0.10.0",
  "description": "modeling-api web app (Expert and Guided modes)",
  "license": "AGPL-3.0-only OR LicenseRef-mapi-commercial",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:smoke": "playwright test",
    "e2e": "MAPI_E2E=1 playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "openapi:gen": "uv run python scripts/gen_openapi.py",
    "openapi:fetch": "node scripts/fetch-openapi.mjs",
    "openapi:types": "openapi-typescript openapi.json -o src/api/schema.d.ts --default-non-nullable false",
    "openapi:check": "openapi-typescript openapi.json -o src/api/schema.d.ts --default-non-nullable false --check"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@mapi/plot-sandbox": "workspace:*",
    "@tanstack/react-query": "5.103.3",
    "@tanstack/react-router": "1.170.37",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.12",
    "@xyflow/react": "12.12.0",
    "apache-arrow": "21.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "monaco-editor": "0.52.2",
    "monaco-yaml": "5.5.1",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
