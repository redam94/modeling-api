# Cloud SQL for PostgreSQL 16, private IP only, TLS required, managed connection pooling.
#
# Four login roles, each in its own Secret Manager secret as a full connection URL:
#   mapi_migrate       owns the schema; runs Alembic (and creates the RLS policies)
#   mapi_app           tenant sessions everywhere: NOT the table owner, so FORCE ROW LEVEL
#                      SECURITY binds it
#   mapi_gateway       API and events platform sessions (sign-in lookups, operator routes,
#                      quota counters): no BYPASSRLS, narrow grants (migration 0004)
#   mapi_orchestrator  dispatcher, reconciler, finalizer only; the platform role that passes
#                      row-level security (plan §9: never held by the internet-facing services)
#
# Passwords are generated by an ephemeral resource and written with write-only arguments, so
# they never appear in the state or a plan file. Raise database.password_version to rotate
# all of them on the next apply (users and secrets change in the same run).

locals {
  db_roles = toset(["app", "gateway", "orchestrator", "migrate"])
  db_name  = "mapi"
}

resource "google_sql_database_instance" "main" {
  project             = var.project_id
  name                = "${local.prefix}-pg"
  region              = var.region
  database_version    = "POSTGRES_16"
  deletion_protection = var.deletion_protection

  settings {
    edition                     = var.database.edition
    tier                        = var.database.tier
    availability_type           = var.database.availability_type
    disk_type                   = "PD_SSD"
    disk_size                   = var.database.disk_size_gb
    disk_autoresize             = true
    deletion_protection_enabled = var.deletion_protection
    user_labels                 = var.labels

    ip_configuration {
      ipv4_enabled                                  = false
      private_network                               = google_compute_network.control.id
      allocated_ip_range                            = google_compute_global_address.psa.name
      ssl_mode                                      = "ENCRYPTED_ONLY"
      enable_private_path_for_google_cloud_services = false
    }

    backup_configuration {
      enabled                        = true
      point_in_time_recovery_enabled = true
      start_time                     = "02:00"
      transaction_log_retention_days = var.database.pitr_log_days

      backup_retention_settings {
        retained_backups = var.database.backup_retained_count
        retention_unit   = "COUNT"
      }
    }

    maintenance_window {
      day          = var.database.maintenance_day
      hour         = var.database.maintenance_hour
      update_track = "stable"
    }

    insights_config {
      query_insights_enabled  = var.database.query_insights_enabled
      record_application_tags = true
      record_client_address   = false
    }

    password_validation_policy {
      enable_password_policy      = true
      min_length                  = 32
      complexity                  = "COMPLEXITY_DEFAULT"
      disallow_username_substring = true
    }

    database_flags {
      name  = "log_min_duration_statement"
      value = "1000"
    }
    database_flags {
      name  = "log_lock_waits"
      value = "on"
    }
    database_flags {
      name  = "log_temp_files"
      value = "0"
    }
    database_flags {
      name  = "log_checkpoints"
      value = "on"
    }

    # Transaction pooling is safe for RLS because the server sets the tenant with SET LOCAL /
    # set_config(..., true) per transaction (plan §9); session state never leaks across clients.
    dynamic "connection_pool_config" {
      for_each = var.database.connection_pooling ? [1] : []
      content {
        connection_pooling_enabled = true
        flags {
          name  = "pool_mode"
          value = "transaction"
        }
        flags {
          name  = "max_pool_size"
          value = tostring(var.database.max_pool_size)
        }
      }
    }
  }

  depends_on = [google_service_networking_connection.psa]
}

resource "google_sql_database" "mapi" {
  project  = var.project_id
  instance = google_sql_database_instance.main.name
  name     = local.db_name
}

ephemeral "random_password" "db" {
  for_each = local.db_roles

  length           = 40
  special          = true
  override_special = "-_.~" # URL-safe: the password goes into a connection URL unescaped
  min_upper        = 2
  min_lower        = 2
  min_numeric      = 2
  min_special      = 2
}

resource "google_sql_user" "role" {
  for_each = local.db_roles

  project             = var.project_id
  instance            = google_sql_database_instance.main.name
  name                = "mapi_${each.key}"
  password_wo         = ephemeral.random_password.db[each.key].result
  password_wo_version = var.database.password_version
  deletion_policy     = "ABANDON" # roles own objects; drop them deliberately, not on destroy
}

locals {
  db_host        = google_sql_database_instance.main.private_ip_address
  db_pooled_port = var.database.connection_pooling ? var.database.pooler_port : 5432
}
