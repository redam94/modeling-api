# The plot sandbox origin (MAPI_PLOTS_ORIGIN), port 8081 (plan §10.3). Pages here render
# inside <iframe sandbox="allow-scripts"> (no same-origin) on the app, so their documents have
# an opaque origin: module scripts, styles and the topojson pack are fetched in CORS mode, which
# is why every response carries Access-Control-Allow-Origin: * (static, public, no cookies).
# Nothing here can reach the API: there is no proxy and connect-src is limited to /topojson/,
# except on the embed page (/embed/<token>), which may read the API's public embed path only.
server {
  listen 8081;
  server_name _;
  root /usr/share/nginx/html/plots;
  index index.html;

  include /tmp/nginx/conf.d/plots-headers.inc;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  # Self-hosted map assets (plan §10.1); the only connect-src target.
  location /topojson/ {
    expires 1d;
    try_files $uri =404;
  }

  # The embed page of a shared plot (/embed/<token>, M3): embed.html with its own policy,
  # whose connect-src adds the API's embed path and nothing else. It is meant to be framed by
  # BI tools, wikis and chat apps (any https site); the page itself refuses to render outside
  # the link's allowed origins. The build leaves a placeholder for the API origin.
  location ~ "^/embed/[^/]+/?$" {
    limit_except GET HEAD { deny all; }
    expires -1;
    include /tmp/nginx/conf.d/plots-embed-headers.inc;
    sub_filter_types text/html;
    sub_filter_once off;
    sub_filter "__MAPI_API_URL__" "${MAPI_API_URL}";
    try_files /embed.html =404;
  }

  location / {
    limit_except GET HEAD { deny all; }
    expires -1;
    try_files $uri $uri/ /index.html;
  }
}
